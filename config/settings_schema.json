[
  {
    "name": "theme_info",
    "theme_name": "AAF Custom Furniture",
    "theme_version": "0.2.0",
    "theme_author": "AAF",
    "theme_documentation_url": "https://github.com/Hemanth2709/aaf-shopify",
    "theme_support_url": "https://github.com/Hemanth2709/aaf-shopify/issues"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "playfair_display_n4",
        "label": "t:labels.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "min": -2,
        "max": 6,
        "step": 1,
        "unit": "px",
        "label": "t:labels.heading_letter_spacing",
        "default": 0
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 32,
        "max": 160,
        "step": 8,
        "unit": "px",
        "label": "t:labels.section_spacing",
        "default": 96
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FAF7F2",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#2B2927",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#F0E9DD",
        "label": "t:labels.surface"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#5C4033",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#7A7064",
        "label": "t:labels.muted"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#D8CEBF",
        "label": "t:labels.border"
      }
    ]
  },
  {
    "name": "t:general.components",
    "settings": [
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 0
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.button_corner_radius",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "t:labels.enable_animations",
        "default": true
      }
    ]
  }
]
