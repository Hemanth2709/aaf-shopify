<article class="article-page full-width">
  <header class="article-page__header page-width">
    <a class="link-arrow" href="{{ blog.url }}">{% render 'icon', name: 'arrow-left' %}{{ blog.title | escape }}</a>
    <h1 class="heading heading--xl article-page__title">{{ article.title | escape }}</h1>
    {%- assign date = article.published_at | time_tag: format: 'date' -%}
    <p class="eyebrow">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
  </header>
  {%- if article.image -%}
    <div class="article-page__hero media ratio-wide">
      {{ article.image | image_url: width: 2400 | image_tag: widths: '800, 1200, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: article.image.alt }}
    </div>
  {%- endif -%}
  <div class="article-page__body page-width">
    <div class="rte">{{ article.content }}</div>

    {%- if blog.comments_enabled? -%}
      <section class="article-page__comments" id="comments">
        <h2 class="heading heading--sm">{{ 'blog.article_comments' | t }}</h2>
        {%- paginate article.comments by 10 -%}
          {%- for comment in article.comments -%}
            <div class="article-comment">
              <p><strong>{{ comment.author | escape }}</strong> · <span class="muted">{{ comment.created_at | time_tag: format: 'date' }}</span></p>
              <div class="rte">{{ comment.content }}</div>
            </div>
          {%- endfor -%}
          {{ paginate | default_pagination: anchor: 'comments' }}
        {%- endpaginate -%}

        {%- form 'new_comment', article, class: 'article-page__form' -%}
          <h3 class="heading heading--xs">{{ 'blog.comment_form_title' | t }}</h3>
          {{ form.errors | default_errors }}
          {%- if form.posted_successfully? -%}
            <p role="status">{{ 'blog.comment_posted' | t }}</p>
          {%- endif -%}
          <div class="field-row">
            <div class="field">
              <label for="comment-author">{{ 'blog.comment_form_name' | t }}</label>
              <input type="text" name="comment[author]" id="comment-author" value="{{ form.author }}" required autocomplete="name">
            </div>
            <div class="field">
              <label for="comment-email">{{ 'blog.comment_form_email' | t }}</label>
              <input type="email" name="comment[email]" id="comment-email" value="{{ form.email }}" required autocomplete="email">
            </div>
          </div>
          <div class="field">
            <label for="comment-body">{{ 'blog.comment_form_body' | t }}</label>
            <textarea name="comment[body]" id="comment-body" rows="5" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="button">{{ 'blog.comment_form_submit' | t }}</button>
        {%- endform -%}
      </section>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .article-page__header {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    padding-block: var(--space-xl) var(--space-lg);
    max-width: 52rem;
  }
  .article-page__title {
    font-size: var(--heading-lg);
  }
  .article-page__body {
    display: grid;
    gap: var(--space-xl);
    max-width: 44rem;
    padding-block: var(--space-xl) var(--section-spacing);
    font-size: var(--text-md);
  }
  .article-page__comments,
  .article-page__form {
    display: grid;
    gap: var(--space-md);
  }
  .article-comment {
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }
  .article-page__form .button {
    justify-self: start;
  }
  @media (min-width: 750px) {
    .article-page .field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-sm);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "class": "section-article",
  "settings": []
}
{% endschema %}
