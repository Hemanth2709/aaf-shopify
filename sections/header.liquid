<header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}">
  <div class="site-header__inner">
    <button
      type="button"
      class="site-header__toggle icon-button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-open
    >
      {% render 'icon', name: 'menu' %}
      <span class="visually-hidden">{{ 'header.open_menu' | t }}</span>
    </button>

    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 600 | image_tag:
          widths: '150, 300, 600',
          sizes: '200px',
          width: section.settings.logo_width,
          alt: shop.name
        }}
      {%- else -%}
        <span class="site-header__name">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-header__nav" aria-label="{{ 'header.primary_navigation' | t }}">
      <ul class="site-header__list">
        {%- for link in section.settings.menu.links -%}
          <li class="site-header__item">
            <a
              href="{{ link.url }}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title -}}
            </a>
            {%- if link.links.size > 0 -%}
              <ul class="site-header__dropdown">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__icons">
      <a class="icon-button" href="{{ routes.search_url }}">
        {% render 'icon', name: 'search' %}
        <span class="visually-hidden">{{ 'header.search' | t }}</span>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-button" href="{{ routes.account_url }}">
          {% render 'icon', name: 'account' %}
          <span class="visually-hidden">{{ 'header.account' | t }}</span>
        </a>
      {%- endif -%}
      <a class="icon-button site-header__cart" href="{{ routes.cart_url }}">
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden">{{ 'header.cart' | t }}</span>
        {%- if cart.item_count > 0 -%}
          <span class="site-header__count" aria-hidden="true">{{ cart.item_count }}</span>
          <span class="visually-hidden">{{ 'header.cart_count' | t: count: cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  <dialog id="mobile-menu" class="mobile-menu" aria-label="{{ 'header.mobile_navigation' | t }}">
    <div class="mobile-menu__top">
      <button type="button" class="icon-button" data-menu-close>
        {% render 'icon', name: 'close' %}
        <span class="visually-hidden">{{ 'header.close_menu' | t }}</span>
      </button>
    </div>
    <nav>
      <ul class="mobile-menu__list">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a class="heading heading--md" href="{{ link.url }}">{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <ul class="mobile-menu__sub">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </dialog>
</header>

{% stylesheet %}
  .site-header {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    z-index: 10;
  }
  .shopify-section:has(> .site-header--sticky) {
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: var(--page-width);
    margin-inline: auto;
    padding: 1rem var(--page-margin);
  }
  .site-header__logo {
    grid-column: 2;
    text-decoration: none;
    text-align: center;
  }
  .site-header__logo img {
    height: auto;
  }
  .site-header__name {
    font-family: var(--font-heading--family);
    font-size: var(--heading-sm);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .site-header__nav {
    display: none;
    grid-column: 1;
    grid-row: 1;
  }
  .site-header__list,
  .site-header__dropdown,
  .mobile-menu__list,
  .mobile-menu__sub {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header__list {
    display: flex;
    gap: 2rem;
  }
  .site-header__item {
    position: relative;
  }
  .site-header__item > a {
    display: block;
    padding-block: 0.5rem;
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .site-header__item > a:hover,
  .site-header__item > a[aria-current='page'] {
    color: var(--color-accent);
  }
  .site-header__dropdown {
    position: absolute;
    top: 100%;
    left: -1rem;
    min-width: 14rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem);
    transition:
      opacity var(--motion-duration) var(--ease),
      transform var(--motion-duration) var(--ease),
      visibility var(--motion-duration);
  }
  .site-header__item:hover > .site-header__dropdown,
  .site-header__item:focus-within > .site-header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .site-header__dropdown a {
    display: block;
    padding: 0.4rem 0;
    text-decoration: none;
  }
  .site-header__dropdown a:hover {
    color: var(--color-accent);
  }
  .site-header__toggle {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }
  .site-header__icons {
    grid-column: 3;
    grid-row: 1;
    display: flex;
    justify-content: flex-end;
    gap: 0.25rem;
  }
  .icon-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .icon-button:hover {
    color: var(--color-accent);
  }
  .site-header__count {
    position: absolute;
    top: 0.3rem;
    right: 0.15rem;
    min-width: 1.1rem;
    padding-inline: 0.25rem;
    border-radius: 1rem;
    background-color: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: 0.7rem;
    line-height: 1.1rem;
    text-align: center;
  }
  .mobile-menu {
    width: min(26rem, 100%);
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 1rem var(--page-margin) 2rem;
    border: 0;
    overflow-y: auto;
  }
  .mobile-menu::backdrop {
    background: rgb(43 41 39 / 0.45);
  }
  .mobile-menu__list > li {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-menu__list a {
    text-decoration: none;
  }
  .mobile-menu__sub {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
    color: var(--color-muted);
  }
  @media (min-width: 990px) {
    .site-header__nav {
      display: block;
    }
    .site-header__toggle {
      display: none;
    }
    .mobile-menu {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', (event) => {
    const menu = document.getElementById('mobile-menu');
    if (!menu) return;
    const opener = event.target.closest('[data-menu-open]');
    if (opener) {
      menu.showModal();
      opener.setAttribute('aria-expanded', 'true');
    }
    if (event.target.closest('[data-menu-close]') || event.target === menu) {
      menu.close();
    }
  });
  document.addEventListener(
    'close',
    (event) => {
      if (event.target.id !== 'mobile-menu') return;
      const opener = document.querySelector('[data-menu-open]');
      if (opener) opener.setAttribute('aria-expanded', 'false');
    },
    true
  );
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "t:labels.logo_width",
      "default": 140
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:labels.sticky_header",
      "default": true
    }
  ]
}
{% endschema %}
