{%- assign items = section.blocks | where: 'type', 'collection' -%}

<div class="curated color-scheme {{ section.settings.color_scheme }} full-width section-spacing">
  <div class="page-width">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      link_label: section.settings.link_label,
      link_url: section.settings.link,
      align: 'split'
    %}

    <ul class="curated__grid curated__grid--{{ items.size | at_most: 4 }}" role="list">
      {%- for block in items limit: 4 -%}
        {%- liquid
          assign collection_item = block.settings.collection
          assign image = block.settings.image | default: collection_item.featured_image
          assign title = block.settings.title | default: collection_item.title
          assign url = collection_item.url | default: routes.collections_url
        -%}
        <li class="curated__item" {{ block.shopify_attributes }} data-reveal style="--reveal-delay: {{ forloop.index0 | times: 0.1 }}s">
          <a class="curated__link" href="{{ url }}">
            <div class="curated__media media media--zoom">
              {%- if image != blank -%}
                {%- if forloop.first -%}
                  {%- assign item_sizes = '(min-width: 990px) 50vw, 100vw' -%}
                {%- else -%}
                  {%- assign item_sizes = '(min-width: 990px) 25vw, 100vw' -%}
                {%- endif -%}
                {{
                  image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '500, 800, 1100, 1600',
                    sizes: item_sizes,
                    loading: 'lazy',
                    alt: title
                }}
              {%- else -%}
                {%- capture placeholder_type -%}lifestyle-{{ forloop.index | modulo: 2 | plus: 1 }}{%- endcapture -%}
                {% render 'placeholder', type: placeholder_type, tone: 'dark', label: 'Collection image, 1600 x 2000' %}
              {%- endif -%}
            </div>
            <div class="curated__content">
              {%- if block.settings.label != blank -%}
                <p class="eyebrow">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              <h3 class="heading heading--md">{{ title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="curated__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
              <span class="link-arrow">{{ 'sections.featured_collections.explore' | t }}{% render 'icon', name: 'arrow' %}</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .curated__grid {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
  }
  .curated__link {
    position: relative;
    display: grid;
    min-height: 26rem;
    height: 100%;
    overflow: hidden;
    color: var(--color-ivory);
    text-decoration: none;
    isolation: isolate;
  }
  .curated__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .curated__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(20 18 16 / 0.7), rgb(20 18 16 / 0) 60%);
  }
  .curated__content {
    display: grid;
    align-content: end;
    justify-items: start;
    gap: 0.6rem;
    padding: var(--space-md);
  }
  .curated__content .eyebrow {
    color: var(--color-sand);
  }
  .curated__text {
    max-width: 26rem;
    color: rgb(247 243 236 / 0.82);
    font-size: var(--text-sm);
  }
  @media (min-width: 750px) {
    .curated__grid--2,
    .curated__grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .curated__grid--3 {
      grid-template-columns: 1.3fr 1fr;
      grid-template-rows: repeat(2, minmax(20rem, 1fr));
    }
    .curated__grid--3 .curated__item:first-child {
      grid-row: span 2;
    }
    .curated__content {
      padding: var(--space-lg);
    }
  }
  @media (min-width: 990px) {
    .curated__grid--3 {
      grid-template-rows: repeat(2, minmax(22rem, 1fr));
    }
    .curated__grid--4 {
      grid-template-columns: 1.4fr 1fr 1fr;
      grid-template-rows: repeat(2, minmax(20rem, 1fr));
    }
    .curated__grid--4 .curated__item:first-child {
      grid-row: span 2;
    }
    .curated__grid--4 .curated__item:last-child {
      grid-column: span 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collections",
  "class": "section-curated",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "options": [
        { "value": "scheme-ivory", "label": "t:options.scheme.ivory" },
        { "value": "scheme-cream", "label": "t:options.scheme.cream" },
        { "value": "scheme-sand", "label": "t:options.scheme.sand" },
        { "value": "scheme-charcoal", "label": "t:options.scheme.charcoal" }
      ],
      "default": "scheme-ivory"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Curated collections"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Edited for <em>the way you live</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.button_label",
      "default": "All collections"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.button_link",
      "default": "/collections"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:general.collection",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image_override"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.eyebrow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title_override"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collections",
      "blocks": [
        { "type": "collection", "settings": { "title": "The living room edit", "label": "Collection" } },
        { "type": "collection", "settings": { "title": "Dining, together", "label": "Collection" } },
        { "type": "collection", "settings": { "title": "Quiet bedrooms", "label": "Collection" } }
      ]
    }
  ]
}
{% endschema %}
