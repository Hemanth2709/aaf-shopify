<div class="featured-collections section-spacing">
  <div class="section-heading">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="heading heading--lg">{{ section.settings.heading | escape }}</h2>
  </div>

  <ul class="featured-collections__grid" style="--columns: {{ section.settings.columns }}">
    {%- for collection in section.settings.collections limit: 6 -%}
      <li>
        <a class="featured-collections__card" href="{{ collection.url }}">
          <div class="image-frame featured-collections__media">
            {%- if collection.featured_image != blank -%}
              {{ collection.featured_image | image_url: width: 1000 | image_tag:
                widths: '400, 600, 800, 1000',
                sizes: '(min-width: 990px) 33vw, 100vw',
                loading: 'lazy'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'featured-collections__placeholder' }}
            {%- endif -%}
          </div>
          <h3 class="heading heading--md featured-collections__title">{{ collection.title | escape }}</h3>
        </a>
      </li>
    {%- else -%}
      {%- for i in (1..3) -%}
        <li>
          <div class="image-frame featured-collections__media">
            {{ 'collection-1' | placeholder_svg_tag: 'featured-collections__placeholder' }}
          </div>
          <h3 class="heading heading--md featured-collections__title">{{ 'sections.featured_collections.placeholder_title' | t }}</h3>
        </li>
      {%- endfor -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .featured-collections__grid {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .featured-collections__card {
    display: block;
    text-decoration: none;
  }
  .featured-collections__media {
    aspect-ratio: 4 / 5;
  }
  .featured-collections__media img,
  .featured-collections__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured-collections__placeholder {
    background-color: var(--color-surface);
    fill: var(--color-muted);
  }
  .featured-collections__title {
    margin-top: var(--space-sm);
  }
  @media (min-width: 750px) {
    .featured-collections__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop by room"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:labels.collections",
      "limit": 6
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:labels.columns",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collections"
    }
  ]
}
{% endschema %}
