<div class="featured-products section-spacing">
  <div class="section-heading">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="heading heading--lg">{{ section.settings.heading | escape }}</h2>
  </div>

  <ul class="featured-products__grid" style="--columns: {{ section.settings.columns }}">
    {%- for product in section.settings.collection.products limit: section.settings.limit -%}
      <li>{% render 'product-card', product: product %}</li>
    {%- endfor -%}
  </ul>

  {%- if section.settings.collection != blank -%}
    <p class="featured-products__more">
      <a class="button button--secondary" href="{{ section.settings.collection.url }}">
        {{- 'sections.featured_products.view_all' | t -}}
      </a>
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .featured-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md) var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .featured-products__more {
    margin-top: var(--space-lg);
    text-align: center;
  }
  @media (min-width: 990px) {
    .featured-products__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
      gap: var(--space-lg) var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Ready to ship"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Best sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:labels.product_count",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:labels.columns",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_products"
    }
  ]
}
{% endschema %}
