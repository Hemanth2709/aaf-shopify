{%- liquid
  assign source = section.settings.collection
  assign limit = section.settings.product_count
  assign link_url = section.settings.link | default: source.url
-%}

<div {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}" {% endif %}class="featured-products color-scheme {{ section.settings.color_scheme }} full-width section-spacing">
  <div class="page-width">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      link_label: section.settings.link_label,
      link_url: link_url,
      align: 'split'
    %}

    <ul
      class="featured-products__list scroller scroller--desktop-grid"
      role="list"
      style="--columns-desktop: {{ section.settings.columns }}; --scroller-item: 72%;"
    >
      {%- if source != blank and source.products_count > 0 -%}
        {%- for product in source.products limit: limit -%}
          <li data-reveal style="--reveal-delay: {{ forloop.index0 | times: 0.06 }}s">
            {% render 'product-card',
              product: product,
              sizes: '(min-width: 990px) 25vw, (min-width: 750px) 44vw, 72vw',
              list_name: section.settings.heading
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="featured-products__empty">
            <div class="media {{ settings.card_image_ratio }}">
              {%- capture placeholder_type -%}product-{{ i }}{%- endcapture -%}
              {% render 'placeholder', type: placeholder_type, label: 'Select a collection in the theme editor' %}
            </div>
            <p class="heading heading--xs">{{ 'sections.featured_products.placeholder_title' | t }}</p>
            <p class="muted small">{{ 'sections.featured_products.placeholder_price' | t }}</p>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .featured-products__list {
    margin: 0;
    padding: 0;
  }
  .featured-products__empty {
    display: grid;
    gap: 0.6rem;
  }
  @media (max-width: 989px) {
    .featured-products__list {
      margin-right: calc(var(--page-margin) * -1);
      padding-right: var(--page-margin);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_products",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "options": [
        { "value": "scheme-ivory", "label": "t:options.scheme.ivory" },
        { "value": "scheme-cream", "label": "t:options.scheme.cream" },
        { "value": "scheme-sand", "label": "t:options.scheme.sand" }
      ],
      "default": "scheme-ivory"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Ready stock"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "In stock and <em>ready to deliver</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:labels.product_count",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.columns",
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.button_label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.button_link",
      "info": "t:info.defaults_to_collection"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:labels.anchor",
      "info": "t:info.anchor"
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_products"
    }
  ]
}
{% endschema %}
