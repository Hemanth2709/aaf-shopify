{%- assign categories = section.blocks | where: 'type', 'category' -%}

<div class="category-grid color-scheme {{ section.settings.color_scheme }} full-width section-spacing">
  <div class="page-width">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      link_label: section.settings.link_label,
      link_url: section.settings.link,
      align: 'split'
    %}

    <ul
      class="category-grid__list {{ section.settings.mobile_layout }}"
      role="list"
      style="--columns-desktop: {{ section.settings.columns }};"
    >
      {%- for block in categories -%}
        {%- liquid
          assign category = block.settings.collection
          assign image = block.settings.image | default: category.featured_image
          assign title = block.settings.title | default: category.title
          assign url = block.settings.link | default: category.url
        -%}
        <li class="category-tile" {{ block.shopify_attributes }} data-reveal style="--reveal-delay: {{ forloop.index0 | times: 0.06 }}s">
          <a href="{{ url | default: routes.collections_url }}" class="category-tile__link">
            <div class="media {{ section.settings.image_ratio }} media--zoom">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 900
                  | image_tag:
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 990px) 20vw, 45vw',
                    loading: 'lazy',
                    alt: title
                }}
              {%- else -%}
                {%- capture placeholder_type -%}collection-{{ forloop.index | modulo: 6 | plus: 1 }}{%- endcapture -%}
                {% render 'placeholder', type: placeholder_type, label: 'Category image, 900 x 1125' %}
              {%- endif -%}
            </div>
            <div class="category-tile__label">
              <span class="category-tile__title">{{ title | escape }}</span>
              {%- if section.settings.show_count and category.products_count > 0 -%}
                <span class="category-tile__count">{{ 'collections.product_count' | t: count: category.products_count }}</span>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .category-grid__list {
    margin: 0;
    padding: 0;
  }
  .category-grid__list.mobile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--space-sm);
  }
  .category-grid__list.mobile-scroll {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 62%;
    gap: var(--space-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-right: calc(var(--page-margin) * -1);
    padding-right: var(--page-margin);
  }
  .category-grid__list.mobile-scroll::-webkit-scrollbar {
    display: none;
  }
  .category-grid__list.mobile-scroll > li {
    scroll-snap-align: start;
  }
  .category-tile__link {
    display: grid;
    gap: 0.9rem;
    text-decoration: none;
  }
  .category-tile__label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
    transition: border-color var(--motion-duration) var(--ease);
  }
  .category-tile__link:hover .category-tile__label {
    border-color: var(--color-foreground);
  }
  .category-tile__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
  }
  .category-tile__count {
    font-size: var(--text-xs);
    color: var(--color-muted);
    white-space: nowrap;
  }
  @media (min-width: 750px) {
    .category-grid__list.mobile-grid,
    .category-grid__list.mobile-scroll {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
      margin-right: 0;
      padding-right: 0;
      gap: var(--space-lg) var(--space-md);
    }
  }
  @media (min-width: 990px) {
    .category-grid__list.mobile-grid,
    .category-grid__list.mobile-scroll {
      grid-template-columns: repeat(var(--columns-desktop, 4), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.category_grid",
  "class": "section-category-grid",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "options": [
        { "value": "scheme-ivory", "label": "t:options.scheme.ivory" },
        { "value": "scheme-cream", "label": "t:options.scheme.cream" },
        { "value": "scheme-sand", "label": "t:options.scheme.sand" }
      ],
      "default": "scheme-ivory"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Every room, <em>considered</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.button_label",
      "default": "All collections"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.button_link",
      "default": "/collections"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "t:labels.columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:labels.mobile_layout",
      "options": [
        { "value": "mobile-grid", "label": "t:options.mobile_layout.grid" },
        { "value": "mobile-scroll", "label": "t:options.mobile_layout.scroll" }
      ],
      "default": "mobile-grid"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "ratio-portrait", "label": "t:options.ratio.portrait" },
        { "value": "ratio-square", "label": "t:options.ratio.square" },
        { "value": "ratio-tall", "label": "t:options.ratio.tall" }
      ],
      "default": "ratio-portrait"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:labels.show_count",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:general.category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title_override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image_override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link_override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.category_grid",
      "blocks": [
        { "type": "category", "settings": { "title": "Sofas" } },
        { "type": "category", "settings": { "title": "Dining" } },
        { "type": "category", "settings": { "title": "Bedroom" } },
        { "type": "category", "settings": { "title": "Storage" } }
      ]
    }
  ]
}
{% endschema %}
