<div class="blog-page full-width section-spacing--tight">
  <div class="page-width">
    <header class="collections-page__header blog-page__header">
      <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="heading heading--xl blog-page__title">{{ blog.title | escape }}</h1>
    </header>
    {%- paginate blog.articles by 9 -%}
      <ul class="blog-page__grid" role="list">
        {%- for article in blog.articles -%}
          <li>
            <a class="blog-card" href="{{ article.url }}">
              <div class="media ratio-landscape media--zoom">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.image.alt }}
                {%- else -%}
                  {% render 'placeholder', type: 'lifestyle-1' %}
                {%- endif -%}
              </div>
              <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
              <h2 class="heading heading--sm">{{ article.title | escape }}</h2>
              {%- if article.excerpt != blank -%}
                <p class="small muted">{{ article.excerpt | strip_html | truncatewords: 26 }}</p>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'collections.pagination' | t }}">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .blog-page__title {
    font-size: var(--heading-lg);
  }
  .blog-page__grid {
    display: grid;
    gap: var(--space-xl) var(--space-md);
    margin: 0;
  }
  .blog-card {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
  }
  .blog-card .media {
    margin-bottom: 0.4rem;
  }
  @media (min-width: 750px) {
    .blog-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 990px) {
    .blog-page__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "class": "section-blog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "The journal"
    }
  ]
}
{% endschema %}
