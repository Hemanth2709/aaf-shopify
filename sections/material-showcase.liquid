{%- assign materials = metaobjects.material.values -%}

<div class="materials section-spacing">
  <div class="section-heading">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="heading heading--lg">{{ section.settings.heading | escape }}</h2>
  </div>

  {%- if materials.size > 0 -%}
    <ul class="materials__grid">
      {%- for material in materials -%}
        <li class="materials__item">
          <div class="image-frame materials__swatch">
            {%- if material.swatch.value != blank -%}
              {{ material.swatch.value | image_url: width: 600 | image_tag:
                widths: '300, 450, 600',
                sizes: '(min-width: 990px) 20vw, 50vw',
                loading: 'lazy'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'materials__placeholder' }}
            {%- endif -%}
          </div>
          <h3 class="heading heading--sm">{{ material.title.value | escape }}</h3>
          {%- if material.description.value != blank -%}
            <p class="materials__text">{{ material.description.value | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    <p class="materials__text">{{ 'sections.material_showcase.empty_editor' | t }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .materials__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md) var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .materials__swatch {
    aspect-ratio: 1;
    margin-bottom: var(--space-sm);
  }
  .materials__swatch img,
  .materials__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .materials__text {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  @media (min-width: 990px) {
    .materials__grid {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-lg) var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.material_showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Materials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Timbers, fabrics and finishes"
    }
  ],
  "presets": [
    {
      "name": "t:general.material_showcase"
    }
  ]
}
{% endschema %}
