{%- assign steps = section.blocks | where: 'type', 'step' -%}

<div class="process color-scheme {{ section.settings.color_scheme }} full-width section-spacing">
  <div class="page-width">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      align: 'split'
    %}

    <ol class="process__list" role="list" style="--steps: {{ steps.size | at_least: 1 }};">
      {%- for block in steps -%}
        <li class="process__step" {{ block.shopify_attributes }} data-reveal style="--reveal-delay: {{ forloop.index0 | times: 0.08 }}s">
          {%- if block.settings.image != blank -%}
            <div class="process__media media ratio-landscape">
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 90vw', alt: block.settings.image.alt }}
            </div>
          {%- endif -%}
          <span class="process__number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
          <h3 class="heading heading--sm">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="process__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.button_label != blank -%}
      <div class="process__cta">
        <a
          class="button"
          href="{{ section.settings.button_link | default: settings.enquiry_url | default: routes.root_url }}"
          data-track="select_journey"
          data-track-params='{"journey":"custom","location":"process"}'
        >
          {{- section.settings.button_label | escape -}}
        </a>
        {%- if section.settings.note != blank -%}
          <p class="small muted">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .process__list {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
  }
  .process__step {
    position: relative;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .process__media {
    margin-bottom: 0.5rem;
  }
  .process__number {
    font-family: var(--font-heading--family);
    font-size: var(--heading-md);
    line-height: 1;
    color: var(--color-heading-accent);
  }
  .process__text {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .process__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }
  @media (min-width: 750px) {
    .process__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 990px) {
    .process__list {
      grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
      gap: var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.process_steps",
  "class": "section-process",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "options": [
        { "value": "scheme-ivory", "label": "t:options.scheme.ivory" },
        { "value": "scheme-cream", "label": "t:options.scheme.cream" },
        { "value": "scheme-sand", "label": "t:options.scheme.sand" },
        { "value": "scheme-charcoal", "label": "t:options.scheme.charcoal" }
      ],
      "default": "scheme-ivory"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "How it works"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "From brief to <em>your home</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Start your design"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:labels.note",
      "default": "No commitment. You receive a quotation before anything is made."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:general.step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Step"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.process_steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Share your brief" } },
        { "type": "step", "settings": { "title": "Review the design" } },
        { "type": "step", "settings": { "title": "We make it" } },
        { "type": "step", "settings": { "title": "Delivered home" } }
      ]
    }
  ]
}
{% endschema %}
