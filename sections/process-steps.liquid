<div class="process section-spacing">
  <div class="section-heading">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="heading heading--lg">{{ section.settings.heading | escape }}</h2>
  </div>

  <ol class="process__list">
    {%- for block in section.blocks -%}
      <li class="process__step" {{ block.shopify_attributes }}>
        <span class="process__number heading heading--md" aria-hidden="true">{{ forloop.index }}</span>
        <h3 class="heading heading--sm">{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </li>
    {%- endfor -%}
  </ol>

  {%- if section.settings.button_label != blank -%}
    <p class="process__cta">
      <a class="button" href="{{ section.settings.button_link | default: routes.root_url }}">
        {{- section.settings.button_label | escape -}}
      </a>
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .process__list {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .process__step {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .process__number {
    color: var(--color-accent);
  }
  .process__step p {
    color: var(--color-muted);
  }
  .process__cta {
    margin-top: var(--space-xl);
    text-align: center;
  }
  @media (min-width: 750px) {
    .process__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.process_steps",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "From idea to delivery"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Start your enquiry"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:general.step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Step title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.text",
          "default": "Describe this step of the process."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:general.process_steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Share your brief",
            "text": "Tell us what you need, the space it is for and any references."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Receive a quotation",
            "text": "We reply with a proposal, timeline and price."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "We craft it",
            "text": "Your piece is built by hand in our workshop."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Delivery",
            "text": "White-glove delivery and installation."
          }
        }
      ]
    }
  ]
}
{% endschema %}
