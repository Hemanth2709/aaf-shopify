<div class="password-page color-scheme scheme-charcoal full-width">
  <div class="password-page__inner">
    <p class="site-header__wordmark">{{ shop.name | escape }}</p>
    <h1 class="heading heading--lg">{{ 'password.title' | t }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="lead">{{ shop.password_message }}</p>
    {%- endif -%}
    {%- form 'storefront_password', class: 'password-page__form' -%}
      {%- if form.errors -%}
        <div role="alert" class="password-page__error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label for="password-input">{{ 'password.password' | t }}</label>
      <div class="password-page__row">
        <input type="password" name="password" id="password-input" autocomplete="current-password" required>
        <button type="submit" class="button button--light">{{ 'password.enter' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .password-page {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: var(--space-xl) var(--page-margin);
  }
  .password-page__inner {
    display: grid;
    gap: var(--space-md);
    justify-items: center;
    max-width: 32rem;
    text-align: center;
  }
  .password-page__form {
    display: grid;
    gap: 0.5rem;
    width: 100%;
    text-align: left;
  }
  .password-page__row {
    display: flex;
    gap: 0.5rem;
  }
  .password-page__error {
    color: #f3b7a8;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "class": "section-password",
  "settings": []
}
{% endschema %}
