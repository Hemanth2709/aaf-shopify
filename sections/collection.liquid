{%- paginate collection.products by section.settings.per_page -%}
  <div class="collection section-spacing">
    <header class="collection__header">
      <p class="eyebrow">{{ 'collections.eyebrow' | t }}</p>
      <h1 class="heading heading--lg">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection__description">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    <form class="collection__toolbar" id="collection-filters" method="get" data-collection-form>
      {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
        {%- assign active_count = 0 -%}
        {%- for filter in collection.filters -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
              {%- assign active_count = active_count | plus: 1 -%}
            {%- endif -%}
          {%- else -%}
            {%- assign active_count = active_count | plus: filter.active_values.size -%}
          {%- endif -%}
        {%- endfor -%}

        <details class="collection__filters">
          <summary class="button button--secondary">
            {{- 'collections.filters.title' | t -}}
            {%- if active_count > 0 -%}
              <span>({{ active_count }})</span>
            {%- endif -%}
          </summary>
          <div class="collection__filter-panel">
            {%- for filter in collection.filters -%}
              <fieldset class="collection__filter">
                <legend class="eyebrow">{{ filter.label | escape }}</legend>
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <div class="collection__price">
                      <label>
                        <span class="visually-hidden">{{ 'collections.filters.price_from' | t }}</span>
                        <input
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          min="0"
                          max="{{ filter.range_max | divided_by: 100 }}"
                          placeholder="0"
                          {% if filter.min_value.value != nil %}
                            value="{{ filter.min_value.value | divided_by: 100 }}"
                          {% endif %}
                        >
                      </label>
                      <label>
                        <span class="visually-hidden">{{ 'collections.filters.price_to' | t }}</span>
                        <input
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          min="0"
                          max="{{ filter.range_max | divided_by: 100 }}"
                          placeholder="{{ filter.range_max | divided_by: 100 }}"
                          {% if filter.max_value.value != nil %}
                            value="{{ filter.max_value.value | divided_by: 100 }}"
                          {% endif %}
                        >
                      </label>
                    </div>
                  {%- else -%}
                    <ul class="collection__filter-list">
                      {%- for value in filter.values -%}
                        <li>
                          <label>
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value | escape }}"
                              {% if value.active %}
                                checked
                              {% endif %}
                              {% if value.count == 0 and value.active == false %}
                                disabled
                              {% endif %}
                            >
                            <span>{{ value.label | escape }} ({{ value.count }})</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                {%- endcase -%}
              </fieldset>
            {%- endfor -%}
            <div class="collection__filter-actions">
              <button type="submit" class="button">{{ 'collections.filters.apply' | t }}</button>
              {%- if active_count > 0 -%}
                <a class="button button--text" href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by }}">
                  {{- 'collections.filters.clear' | t -}}
                </a>
              {%- endif -%}
            </div>
          </div>
        </details>
      {%- endif -%}

      <p class="collection__count">{{ 'collections.product_count' | t: count: collection.products_count }}</p>

      {%- if section.settings.enable_sorting -%}
        <div class="collection__sort">
          <label for="sort-by" class="visually-hidden">{{ 'collections.sort.label' | t }}</label>
          <select id="sort-by" name="sort_by">
            {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option
                value="{{ option.value }}"
                {% if option.value == current_sort %}
                  selected
                {% endif %}
              >
                {{- option.name | escape -}}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </form>

    {%- if collection.filters.size > 0 -%}
      <ul class="collection__active" aria-label="{{ 'collections.filters.active' | t }}">
        {%- for filter in collection.filters -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
              <li>
                <a class="collection__pill" href="{{ filter.url_to_remove }}">
                  {{ filter.label | escape }}
                  {% render 'icon', name: 'close' %}
                </a>
              </li>
            {%- endif -%}
          {%- else -%}
            {%- for value in filter.active_values -%}
              <li>
                <a class="collection__pill" href="{{ value.url_to_remove }}">
                  {{ value.label | escape }}
                  {% render 'icon', name: 'close' %}
                </a>
              </li>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <ul class="collection__grid" style="--columns: {{ section.settings.columns_desktop }}">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav class="collection__pagination" aria-label="{{ 'collections.pagination' | t }}">
          {{- paginate | default_pagination -}}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="collection__empty">{{ 'collections.empty' | t }}</p>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% stylesheet %}
  .collection__header {
    display: grid;
    gap: var(--space-xs);
    max-width: 40rem;
    margin-bottom: var(--space-lg);
  }
  .collection__description {
    color: var(--color-muted);
  }
  .collection__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    padding-block: var(--space-sm);
    border-block: 1px solid var(--color-border);
  }
  .collection__filters {
    position: relative;
  }
  .collection__filters summary {
    list-style: none;
    cursor: pointer;
    padding: 0.6rem 1.5rem;
  }
  .collection__filters summary::-webkit-details-marker {
    display: none;
  }
  .collection__filter-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 5;
    display: grid;
    gap: var(--space-md);
    width: min(36rem, calc(100vw - var(--page-margin) * 2));
    max-height: 70svh;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    overflow-y: auto;
  }
  .collection__filter {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .collection__filter-list {
    display: grid;
    gap: 0.4rem;
    margin: var(--space-xs) 0 0;
    padding: 0;
    list-style: none;
  }
  .collection__filter-list label {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    cursor: pointer;
  }
  .collection__filter-list input {
    width: 1rem;
    height: 1rem;
    padding: 0;
    accent-color: var(--color-accent);
  }
  .collection__price {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }
  .collection__price input {
    width: 100%;
  }
  .collection__filter-actions {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }
  .collection__count {
    margin-left: auto;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .collection__sort select {
    padding-block: 0.6rem;
  }
  .collection__active {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: var(--space-sm) 0 0;
    padding: 0;
    list-style: none;
  }
  .collection__pill {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .collection__pill .icon {
    width: 0.9rem;
    height: 0.9rem;
  }
  .collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md) var(--space-sm);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }
  .collection__pagination {
    margin-top: var(--space-xl);
    text-align: center;
  }
  .collection__empty {
    margin-top: var(--space-xl);
    text-align: center;
    color: var(--color-muted);
  }
  @media (min-width: 990px) {
    .collection__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
      gap: var(--space-lg) var(--space-md);
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('change', (event) => {
    const form = event.target.closest('[data-collection-form]');
    if (!form) return;
    if (event.target.matches('select, input[type="checkbox"]')) form.requestSubmit();
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "t:labels.products_per_page",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:labels.columns",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:labels.enable_filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:labels.enable_sorting",
      "default": true
    }
  ]
}
{% endschema %}
