{%- liquid
  assign items = section.blocks | where: 'type', 'category'
  assign enquiry_base = section.settings.enquiry_url | default: settings.enquiry_url | default: routes.root_url
  assign joiner = '?'
  if enquiry_base contains '?'
    assign joiner = '&'
  endif
  assign use_metaobjects = false
  if items.size == 0 and metaobjects.custom_category.values.size > 0
    assign use_metaobjects = true
  endif
-%}

<div class="bespoke-cats color-scheme {{ section.settings.color_scheme }} full-width section-spacing">
  <div class="page-width">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      align: 'split'
    %}

    <ul class="bespoke-cats__grid" role="list">
      {%- if use_metaobjects -%}
        {%- for category in metaobjects.custom_category.values limit: 12 -%}
          <li data-reveal style="--reveal-delay: {{ forloop.index0 | times: 0.06 }}s">
            <a class="bespoke-cat" href="{{ enquiry_base }}{{ joiner }}category={{ category.title.value | url_encode }}" data-track="select_journey" data-track-params='{"journey":"custom","location":"bespoke_categories"}'>
              <div class="media ratio-portrait media--zoom">
                {%- if category.image.value != blank -%}
                  {{ category.image.value | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: '' }}
                {%- else -%}
                  {% render 'placeholder', type: 'collection-1' %}
                {%- endif -%}
              </div>
              <h3 class="bespoke-cat__title">{{ category.title.value | escape }}</h3>
              {%- if category.description.value != blank -%}
                <p class="bespoke-cat__text">{{ category.description.value | escape }}</p>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for block in items -%}
          <li {{ block.shopify_attributes }} data-reveal style="--reveal-delay: {{ forloop.index0 | times: 0.06 }}s">
            <a class="bespoke-cat" href="{{ enquiry_base }}{{ joiner }}category={{ block.settings.title | url_encode }}" data-track="select_journey" data-track-params='{"journey":"custom","location":"bespoke_categories"}'>
              <div class="media ratio-portrait media--zoom">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.image.alt }}
                {%- else -%}
                  {%- capture placeholder_type -%}collection-{{ forloop.index | modulo: 6 | plus: 1 }}{%- endcapture -%}
                  {% render 'placeholder', type: placeholder_type, label: 'Bespoke category image, 900 x 1125' %}
                {%- endif -%}
              </div>
              <h3 class="bespoke-cat__title">{{ block.settings.title | escape }}<span class="bespoke-cat__arrow">{% render 'icon', name: 'arrow' %}</span></h3>
              {%- if block.settings.text != blank -%}
                <p class="bespoke-cat__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .bespoke-cats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-sm);
    margin: 0;
    padding: 0;
  }
  .bespoke-cat {
    display: grid;
    gap: 0.75rem;
    text-decoration: none;
  }
  .bespoke-cat__title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
  }
  .bespoke-cat__arrow .icon {
    width: 1rem;
    height: 1rem;
    transition: transform var(--motion-duration) var(--ease);
  }
  .bespoke-cat:hover .bespoke-cat__arrow .icon {
    transform: translateX(4px);
  }
  .bespoke-cat__text {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  @media (min-width: 990px) {
    .bespoke-cats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-xl) var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_categories",
  "class": "section-bespoke-categories",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "options": [
        { "value": "scheme-ivory", "label": "t:options.scheme.ivory" },
        { "value": "scheme-cream", "label": "t:options.scheme.cream" },
        { "value": "scheme-sand", "label": "t:options.scheme.sand" }
      ],
      "default": "scheme-ivory"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "What we make"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Choose a piece <em>to begin</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "url",
      "id": "enquiry_url",
      "label": "t:labels.enquiry_url",
      "info": "t:info.enquiry_url"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:general.category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "info": "t:info.category_match",
          "default": "Sofas"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_categories"
    }
  ]
}
{% endschema %}
