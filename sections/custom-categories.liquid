{%- assign categories = metaobjects.custom_category.values -%}

<div class="custom-categories section-spacing">
  <div class="section-heading">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="heading heading--lg">{{ section.settings.heading | escape }}</h2>
  </div>

  {%- if categories.size > 0 -%}
    <ul class="custom-categories__grid">
      {%- for category in categories -%}
        {%- assign category_handle = category.system.handle -%}
        {%- assign category_url = section.settings.enquiry_url | default: routes.root_url | append: '?category=' | append: category_handle -%}
        <li>
          <a class="custom-categories__card" href="{{ category_url }}">
            <div class="image-frame custom-categories__media">
              {%- if category.image.value != blank -%}
                {{ category.image.value | image_url: width: 900 | image_tag:
                  widths: '400, 600, 900',
                  sizes: '(min-width: 990px) 25vw, 50vw',
                  loading: 'lazy'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'custom-categories__placeholder' }}
              {%- endif -%}
            </div>
            <h3 class="heading heading--sm custom-categories__title">{{ category.title.value | escape }}</h3>
            {%- if category.description.value != blank -%}
              <p class="custom-categories__text">{{ category.description.value | escape }}</p>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    <p class="custom-categories__empty">{{ 'sections.custom_categories.empty_editor' | t }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .custom-categories__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md) var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .custom-categories__card {
    display: block;
    text-decoration: none;
  }
  .custom-categories__media {
    aspect-ratio: 4 / 5;
  }
  .custom-categories__media img,
  .custom-categories__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .custom-categories__title {
    margin-top: var(--space-sm);
    font-size: var(--text-lg);
  }
  .custom-categories__text,
  .custom-categories__empty {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  @media (min-width: 990px) {
    .custom-categories__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-lg) var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_categories",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Bespoke"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What would you like made?"
    },
    {
      "type": "url",
      "id": "enquiry_url",
      "label": "t:labels.enquiry_url"
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_categories"
    }
  ]
}
{% endschema %}
