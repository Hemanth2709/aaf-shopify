{%- liquid
  assign socials = 'instagram,pinterest,facebook,youtube,linkedin' | split: ','
  assign has_social = false
  for social in socials
    assign key = 'social_' | append: social
    if settings[key] != blank
      assign has_social = true
    endif
  endfor
-%}

<footer class="site-footer color-scheme scheme-charcoal full-width">
  <div class="page-width">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="site-footer__wordmark" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 480', sizes: '240px', alt: shop.name, class: 'site-footer__logo' }}
          {%- else -%}
            {{ shop.name | escape }}
          {%- endif -%}
        </a>
        {%- if section.settings.statement != blank -%}
          <p class="site-footer__statement heading heading--md">{{ section.settings.statement }}</p>
        {%- endif -%}
        <div class="site-footer__journeys">
          {%- if section.settings.ready_stock_link != blank -%}
            <a class="button button--light" href="{{ section.settings.ready_stock_link }}">{{ 'footer.shop_ready_stock' | t }}</a>
          {%- endif -%}
          {%- if settings.enquiry_url != blank -%}
            <a class="button button--ghost-light" href="{{ settings.enquiry_url }}">{{ 'footer.design_your_own' | t }}</a>
          {%- endif -%}
        </div>
      </div>

      <div class="site-footer__columns">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- if block.settings.menu.links.size > 0 -%}
                <details class="site-footer__column" {{ block.shopify_attributes }} open data-footer-accordion>
                  <summary class="site-footer__heading">
                    {{- block.settings.heading | default: block.settings.menu.title | escape -}}
                    {% render 'icon', name: 'plus' %}
                  </summary>
                  <ul role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- endif -%}
            {%- when 'contact' -%}
              <div class="site-footer__column site-footer__contact" {{ block.shopify_attributes }}>
                <p class="site-footer__heading">{{ block.settings.heading | escape }}</p>
                <ul role="list">
                  {%- if settings.whatsapp_number != blank -%}
                    <li>
                      <a
                        href="{% render 'whatsapp-url' %}"
                        target="_blank"
                        rel="noopener"
                        data-track="contact"
                        data-track-params='{"method":"whatsapp","location":"footer"}'
                      >
                        {%- render 'icon', name: 'whatsapp' -%}
                        {{- 'whatsapp.short' | t -}}
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if settings.contact_phone != blank -%}
                    <li>
                      <a
                        href="tel:{{ settings.contact_phone | remove: ' ' }}"
                        data-track="contact"
                        data-track-params='{"method":"phone","location":"footer"}'
                      >
                        {%- render 'icon', name: 'phone' -%}
                        {{- settings.contact_phone | escape -}}
                      </a>
                    </li>
                  {%- endif -%}
                  {%- assign footer_email = settings.contact_email | default: shop.email -%}
                  {%- if footer_email != blank -%}
                    <li>
                      <a href="mailto:{{ footer_email }}">
                        {%- render 'icon', name: 'mail' -%}
                        {{- footer_email | escape -}}
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if settings.showroom_address != blank -%}
                    <li class="site-footer__address">
                      {%- render 'icon', name: 'pin' -%}
                      <span>{{ settings.showroom_address | escape | newline_to_br }}</span>
                    </li>
                  {%- endif -%}
                </ul>
                {%- if block.settings.text != blank -%}
                  <div class="site-footer__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            {%- when 'text' -%}
              <div class="site-footer__column" {{ block.shopify_attributes }}>
                <p class="site-footer__heading">{{ block.settings.heading | escape }}</p>
                <div class="site-footer__text rte">{{ block.settings.text }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>

      {%- if shop.policies.size > 0 -%}
        <ul class="site-footer__policies" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if has_social -%}
        <ul class="site-footer__social" role="list">
          {%- for social in socials -%}
            {%- assign key = 'social_' | append: social -%}
            {%- if settings[key] != blank -%}
              <li>
                <a class="icon-button" href="{{ settings[key] }}" target="_blank" rel="noopener">
                  {% render 'icon', name: social %}
                  <span class="visually-hidden">{{ social | capitalize }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="site-footer__payment" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    padding-block: var(--space-xl) var(--space-md);
  }
  .site-footer a {
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--color-sand);
  }
  .site-footer__top {
    display: grid;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }
  .site-footer__brand {
    display: grid;
    gap: var(--space-md);
    align-content: start;
    justify-items: start;
  }
  .site-footer__wordmark {
    font-family: var(--font-heading--family);
    font-size: 1.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
  .site-footer__logo {
    max-width: 200px;
  }
  .site-footer__statement {
    max-width: 22ch;
  }
  .site-footer__journeys {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .site-footer__columns {
    display: grid;
    gap: 0;
  }
  .site-footer__column {
    border-top: 1px solid var(--color-border);
  }
  .site-footer__heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1rem;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }
  .site-footer__heading::-webkit-details-marker {
    display: none;
  }
  .site-footer__heading .icon {
    width: 1rem;
    height: 1rem;
  }
  .site-footer__column ul {
    display: grid;
    gap: 0.6rem;
    margin: 0 0 1.25rem;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .site-footer__contact a,
  .site-footer__address {
    display: inline-flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .site-footer__contact .icon {
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.2rem;
  }
  .site-footer__text {
    margin-bottom: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-md);
    padding-top: var(--space-md);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .site-footer__policies,
  .site-footer__social,
  .site-footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__social {
    gap: 0;
  }
  .site-footer__social .icon {
    width: 1.15rem;
    height: 1.15rem;
  }
  .site-footer__payment {
    gap: 0.4rem;
  }
  .site-footer__payment svg {
    width: 2.4rem;
    height: auto;
  }
  @media (min-width: 750px) {
    .site-footer__columns {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
      gap: var(--space-lg);
    }
    .site-footer__column {
      border-top: 0;
    }
    .site-footer__heading {
      pointer-events: none;
      padding-top: 0;
    }
    .site-footer__heading .icon {
      display: none;
    }
  }
  @media (min-width: 990px) {
    .site-footer {
      padding-top: var(--space-2xl);
    }
    .site-footer__top {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
      gap: var(--space-2xl);
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const mq = window.matchMedia('(max-width: 749px)');
    const sync = () => {
      document.querySelectorAll('[data-footer-accordion]').forEach((el) => {
        if (mq.matches) el.removeAttribute('open');
        else el.setAttribute('open', '');
      });
    };
    sync();
    mq.addEventListener('change', sync);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo_light"
    },
    {
      "type": "inline_richtext",
      "id": "statement",
      "label": "t:labels.statement",
      "default": "Furniture for rooms that are <em>lived in</em>"
    },
    {
      "type": "url",
      "id": "ready_stock_link",
      "label": "t:labels.ready_stock_link",
      "default": "/collections/all"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:general.menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact",
      "name": "t:general.contact",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Visit and contact"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:general.text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "About"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Ready-stock furniture and made-to-order pieces, designed and finished with care.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
