<footer class="site-footer full-width">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="heading heading--md">{{ shop.name }}</p>
      {%- if section.settings.tagline != blank -%}
        <p class="site-footer__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.menu.links.size > 0 -%}
      <nav class="site-footer__nav" aria-label="{{ 'footer.navigation' | t }}">
        <ul>
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if section.settings.show_contact -%}
      <div class="site-footer__contact">
        <p class="eyebrow">{{ 'footer.contact' | t }}</p>
        {%- if shop.email != blank -%}
          <p><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
        {%- endif -%}
        {%- if shop.phone != blank -%}
          <p>{{ shop.phone }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</p>
    {%- if section.settings.show_payment_icons -%}
      <ul class="site-footer__payment" aria-label="{{ 'footer.payment_methods' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    margin-top: var(--section-spacing);
    padding: var(--space-xl) var(--page-margin) var(--space-md);
    background-color: var(--color-surface);
  }
  .site-footer a {
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--color-accent);
  }
  .site-footer__inner,
  .site-footer__bottom {
    display: grid;
    gap: var(--space-lg);
    max-width: var(--page-width);
    margin-inline: auto;
  }
  .site-footer__tagline {
    max-width: 28rem;
    margin-top: var(--space-xs);
    color: var(--color-muted);
  }
  .site-footer__nav ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__contact p + p {
    margin-top: 0.25rem;
  }
  .site-footer__bottom {
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .site-footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 750px) {
    .site-footer__inner {
      grid-template-columns: 2fr 1fr 1fr;
    }
    .site-footer__bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "t:labels.tagline",
      "default": "Considered furniture, crafted to last."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "t:labels.show_contact",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
