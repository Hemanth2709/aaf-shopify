{%- assign items = section.blocks | where: 'type', 'question' -%}

<div class="faq color-scheme {{ section.settings.color_scheme }} full-width section-spacing">
  <div class="page-width faq__grid">
    <div class="faq__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="heading heading--lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if settings.whatsapp_number != blank -%}
        <a
          class="link-arrow"
          href="{% render 'whatsapp-url' %}"
          target="_blank"
          rel="noopener"
          data-track="contact"
          data-track-params='{"method":"whatsapp","location":"faq"}'
        >
          {{- 'sections.faq.ask' | t -}}
          {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <div class="faq__list">
      {%- for block in items -%}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question | escape }}</span>
            {% render 'icon', name: 'plus' %}
          </summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.structured_data and items.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in items -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .faq__grid {
    display: grid;
    gap: var(--space-lg);
  }
  .faq__intro {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    justify-items: start;
  }
  .faq__list {
    border-top: 1px solid var(--color-border);
  }
  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    padding-block: 1.25rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    list-style: none;
    cursor: pointer;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary .icon {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform var(--motion-duration) var(--ease);
  }
  .faq__item[open] summary .icon {
    transform: rotate(45deg);
  }
  .faq__answer {
    padding-bottom: 1.5rem;
    max-width: 44rem;
    color: var(--color-muted);
  }
  @media (min-width: 990px) {
    .faq__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-2xl);
    }
    .faq__intro {
      position: sticky;
      top: calc(var(--header-height) + 2rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq",
  "class": "section-faq",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "options": [
        { "value": "scheme-ivory", "label": "t:options.scheme.ivory" },
        { "value": "scheme-cream", "label": "t:options.scheme.cream" },
        { "value": "scheme-sand", "label": "t:options.scheme.sand" }
      ],
      "default": "scheme-ivory"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Questions"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Frequently <em>asked</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "t:labels.faq_structured_data",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:general.faq_item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:labels.question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:labels.answer",
          "default": "<p>Answer</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.faq",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
