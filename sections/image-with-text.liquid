<div class="image-with-text section-spacing image-with-text--{{ section.settings.layout }}">
  <div class="image-with-text__media image-frame">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1400 | image_tag:
        widths: '500, 800, 1100, 1400',
        sizes: '(min-width: 990px) 50vw, 100vw',
        loading: 'lazy'
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'image-with-text__placeholder' }}
    {%- endif -%}
  </div>

  <div class="image-with-text__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="heading heading--lg">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="image-with-text__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button button--secondary" href="{{ section.settings.button_link | default: routes.root_url }}">
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .image-with-text {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }
  .image-with-text__media {
    aspect-ratio: 4 / 5;
  }
  .image-with-text__media img,
  .image-with-text__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .image-with-text__placeholder {
    background-color: var(--color-surface);
    fill: var(--color-muted);
  }
  .image-with-text__content {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    max-width: 34rem;
  }
  .image-with-text__text {
    color: var(--color-muted);
  }
  @media (min-width: 990px) {
    .image-with-text {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
    .image-with-text--image-right .image-with-text__media {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_with_text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "image-left",
          "label": "t:options.image_position.left"
        },
        {
          "value": "image-right",
          "label": "t:options.image_position.right"
        }
      ],
      "default": "image-left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Crafted to your measure"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Choose the timber, the upholstery and the dimensions. Our makers build each piece by hand to your brief.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.image_with_text"
    }
  ]
}
{% endschema %}
