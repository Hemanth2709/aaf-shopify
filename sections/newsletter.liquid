<div class="newsletter color-scheme {{ section.settings.color_scheme }} full-width section-spacing">
  <div class="page-width newsletter__inner" data-reveal>
    <div class="newsletter__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="heading heading--lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- assign form_id = 'newsletter-' | append: section.id -%}
    {%- form 'customer', id: form_id, class: 'newsletter__form', novalidate: 'novalidate' -%}
      {%- if form.posted_successfully? -%}
        <p class="newsletter__message newsletter__message--success" role="status" data-newsletter-success>
          {% render 'icon', name: 'check' %}
          {{ 'sections.newsletter.success' | t }}
        </p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter__field">
          <label class="visually-hidden" for="newsletter-email-{{ section.id }}">{{ 'sections.newsletter.email_label' | t }}</label>
          <input
            id="newsletter-email-{{ section.id }}"
            type="email"
            name="contact[email]"
            autocomplete="email"
            required
            placeholder="{{ 'sections.newsletter.email_placeholder' | t }}"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="newsletter-error-{{ section.id }}"
            {% endif %}
          >
          <button type="submit" class="button">{{ 'sections.newsletter.submit' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="newsletter__message" id="newsletter-error-{{ section.id }}" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <p class="newsletter__legal small muted">{{ 'sections.newsletter.legal' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .newsletter__inner {
    display: grid;
    gap: var(--space-lg);
    align-items: end;
  }
  .newsletter__copy {
    display: grid;
    gap: var(--space-sm);
  }
  .newsletter__field {
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-foreground);
  }
  .newsletter__field input {
    flex: 1 1 14rem;
    border: 0;
    padding-inline: 0;
    background: transparent;
    font-size: var(--text-md);
  }
  .newsletter__field .button {
    --button-bg: transparent;
    --button-fg: var(--color-foreground);
    --button-border: transparent;
    padding-inline: 0 0;
  }
  .newsletter__field .button:hover {
    --button-fg: var(--color-heading-accent);
  }
  .newsletter__message {
    margin-top: 0.75rem;
  }
  .newsletter__message--success {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .newsletter__legal {
    margin-top: 0.75rem;
  }
  @media (min-width: 990px) {
    .newsletter__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const success = document.querySelector('[data-newsletter-success]');
    if (success && window.AAF) window.AAF.track('sign_up', { method: 'newsletter' });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.newsletter",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "options": [
        { "value": "scheme-ivory", "label": "t:options.scheme.ivory" },
        { "value": "scheme-cream", "label": "t:options.scheme.cream" },
        { "value": "scheme-sand", "label": "t:options.scheme.sand" },
        { "value": "scheme-charcoal", "label": "t:options.scheme.charcoal" }
      ],
      "default": "scheme-sand"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "The journal"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "New pieces, <em>first</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "Occasional letters on new collections, ready-stock arrivals and the making of our furniture."
    }
  ],
  "presets": [
    {
      "name": "t:general.newsletter"
    }
  ]
}
{% endschema %}
