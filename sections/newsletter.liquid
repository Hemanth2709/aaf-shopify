<div class="newsletter full-width section-spacing">
  <div class="newsletter__inner">
    <h2 class="heading heading--lg">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="newsletter__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'newsletter-form', novalidate: 'novalidate' -%}
      {%- if form.posted_successfully? -%}
        <p class="newsletter__message" role="status">{{ 'sections.newsletter.success' | t }}</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter__field">
          <label class="visually-hidden" for="newsletter-email">{{ 'sections.newsletter.email_label' | t }}</label>
          <input
            id="newsletter-email"
            type="email"
            name="contact[email]"
            autocomplete="email"
            required
            placeholder="{{ 'sections.newsletter.email_placeholder' | t }}"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="newsletter-error"
            {% endif %}
          >
          <button type="submit" class="button">{{ 'sections.newsletter.submit' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="newsletter__message" id="newsletter-error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .newsletter {
    padding-inline: var(--page-margin);
    background-color: var(--color-surface);
    text-align: center;
  }
  .newsletter__inner {
    display: grid;
    gap: var(--space-sm);
    justify-items: center;
    max-width: 36rem;
    margin-inline: auto;
  }
  .newsletter__text {
    color: var(--color-muted);
  }
  .newsletter__field {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    width: 100%;
  }
  .newsletter__field input[type='email'] {
    flex: 1 1 14rem;
  }
  .newsletter__message {
    font-size: var(--text-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Join the list"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "default": "New collections, studio news and private previews."
    }
  ],
  "presets": [
    {
      "name": "t:general.newsletter"
    }
  ]
}
{% endschema %}
