<div class="collections-page full-width section-spacing--tight">
  <div class="page-width">
    <header class="collections-page__header">
      <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="heading heading--xl collections-page__title">{{ 'collections.title' | t }}</h1>
    </header>
    {%- paginate collections by 24 -%}
      <ul class="collections-page__grid" role="list">
        {%- for item in collections -%}
          <li data-reveal style="--reveal-delay: {{ forloop.index0 | modulo: 4 | times: 0.06 }}s">
            <a class="collections-page__card" href="{{ item.url }}">
              <div class="media ratio-portrait media--zoom">
                {%- if item.featured_image -%}
                  {{ item.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: item.title }}
                {%- else -%}
                  {%- capture placeholder_type -%}collection-{{ forloop.index | modulo: 6 | plus: 1 }}{%- endcapture -%}
                  {% render 'placeholder', type: placeholder_type %}
                {%- endif -%}
              </div>
              <div class="category-tile__label">
                <span class="category-tile__title">{{ item.title | escape }}</span>
                <span class="category-tile__count">{{ 'collections.product_count' | t: count: item.products_count }}</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .collections-page__header {
    display: grid;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }
  .collections-page__title {
    font-size: var(--heading-lg);
  }
  .collections-page__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-sm);
    margin: 0;
  }
  .collections-page__card {
    display: grid;
    gap: 0.9rem;
    text-decoration: none;
  }
  .collections-page__card .category-tile__label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }
  .collections-page__card .category-tile__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
  }
  .collections-page__card .category-tile__count {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  @media (min-width: 990px) {
    .collections-page__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-xl) var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections",
  "class": "section-collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Shop by room"
    }
  ]
}
{% endschema %}
