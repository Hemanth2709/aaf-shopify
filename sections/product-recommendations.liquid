{%- liquid
  assign product_id = product.id | default: section.settings.product.id
-%}

<div
  class="recommendations color-scheme {{ section.settings.color_scheme }} full-width section-spacing"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product_id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="page-width">
      {% render 'section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        align: 'split'
      %}
      <ul class="scroller scroller--desktop-grid recommendations__list" role="list" style="--columns-desktop: {{ section.settings.limit | at_most: 4 }}; --scroller-item: 72%;">
        {%- for recommended in recommendations.products -%}
          <li>
            {% render 'product-card',
              product: recommended,
              sizes: '(min-width: 990px) 25vw, 72vw',
              list_name: section.settings.heading
            %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .recommendations:not(:has(.recommendations__list)) {
    padding: 0;
  }
  .recommendations__list {
    margin: 0;
    padding: 0;
  }
  @media (max-width: 989px) {
    .recommendations__list {
      margin-right: calc(var(--page-margin) * -1);
      padding-right: var(--page-margin);
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const load = (scope) => {
      scope.querySelectorAll('[data-recommendations]').forEach((el) => {
        if (el.dataset.loaded || el.querySelector('.recommendations__list')) return;
        el.dataset.loaded = 'true';
        const fetchIt = async () => {
          try {
            const response = await fetch(el.dataset.url);
            const html = await response.text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const next = doc.querySelector('[data-recommendations]');
            if (next && next.innerHTML.trim()) el.innerHTML = next.innerHTML;
          } catch (error) {}
        };
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              if (entries.some((e) => e.isIntersecting)) {
                io.disconnect();
                fetchIt();
              }
            },
            { rootMargin: '600px 0px' }
          );
          io.observe(el);
        } else {
          fetchIt();
        }
      });
    };
    load(document);
    document.addEventListener('shopify:section:load', (event) => load(event.target));
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product_recommendations",
  "class": "section-recommendations",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "options": [
        { "value": "scheme-ivory", "label": "t:options.scheme.ivory" },
        { "value": "scheme-cream", "label": "t:options.scheme.cream" },
        { "value": "scheme-sand", "label": "t:options.scheme.sand" }
      ],
      "default": "scheme-ivory"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:labels.intent",
      "options": [
        { "value": "related", "label": "t:options.intent.related" },
        { "value": "complementary", "label": "t:options.intent.complementary" }
      ],
      "default": "related",
      "info": "t:info.intent"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "You may also like"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Pieces that <em>belong together</em>"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:labels.product_count",
      "default": 4
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product",
      "info": "t:info.recommendation_product"
    }
  ],
  "presets": [
    {
      "name": "t:general.product_recommendations"
    }
  ]
}
{% endschema %}
