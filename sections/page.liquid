<article class="page section-spacing">
  <h1 class="heading heading--lg page__title">{{ page.title | escape }}</h1>
  <div class="rte page__content">{{ page.content }}</div>
</article>

{% stylesheet %}
  .page {
    display: block;
  }
  .page__title {
    margin-bottom: var(--space-lg);
  }
  .page__content {
    max-width: 48rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
