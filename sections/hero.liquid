{%- liquid
  assign image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: image
  assign journeys = section.blocks | where: 'type', 'journey'
  assign hero_alt = image.alt | default: section.settings.heading | strip_html | escape
-%}

<div
  class="hero full-width hero--{{ section.settings.height }} hero--{{ section.settings.content_position }}"
  style="--overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          image_size: '1920x',
          class: 'hero__video'
      }}
    {%- elsif image != blank -%}
      <picture>
        <source
          media="(min-width: 750px)"
          srcset="{{ image | image_url: width: 1400 }} 1400w, {{ image | image_url: width: 1920 }} 1920w, {{ image | image_url: width: 2600 }} 2600w, {{ image | image_url: width: 3200 }} 3200w"
          sizes="100vw"
        >
        {{
          mobile_image
          | image_url: width: 1500
          | image_tag:
            widths: '600, 900, 1200, 1500',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: hero_alt,
            class: 'hero__image'
        }}
      </picture>
    {%- else -%}
      {% render 'placeholder', type: 'lifestyle-1', tone: 'dark', label: 'Hero image, 3200 x 1800 (mobile 1200 x 1600)' %}
    {%- endif -%}
  </div>

  <div class="hero__content page-width">
    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--rule hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hero__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <div class="button-row hero__buttons">
        {%- if section.settings.primary_label != blank -%}
          <a
            class="button button--light"
            href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
            data-track="select_journey"
            data-track-params='{"journey":"ready_stock","location":"hero"}'
          >
            {{- section.settings.primary_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a
            class="button button--ghost-light"
            href="{{ section.settings.secondary_link | default: settings.enquiry_url }}"
            data-track="select_journey"
            data-track-params='{"journey":"custom","location":"hero"}'
          >
            {{- section.settings.secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if journeys.size > 0 -%}
      <div class="hero__journeys">
        {%- for block in journeys -%}
          <a
            class="hero__journey"
            href="{{ block.settings.link | default: '#' }}"
            {{ block.shopify_attributes }}
            data-track="select_journey"
            data-track-params='{"journey":{{ block.settings.title | handleize | json | escape }},"location":"hero_card"}'
          >
            <span class="hero__journey-index">{{ forloop.index | prepend: '0' }}</span>
            <span class="hero__journey-body">
              <span class="hero__journey-title">{{ block.settings.title | escape }}</span>
              <span class="hero__journey-text">{{ block.settings.text | escape }}</span>
            </span>
            {% render 'icon', name: 'arrow' %}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    min-height: var(--hero-height, 88svh);
    overflow: hidden;
    color: var(--color-ivory);
    background-color: var(--color-charcoal);
  }
  .hero--full {
    --hero-height: 100svh;
  }
  .hero--large {
    --hero-height: 88svh;
  }
  .hero--medium {
    --hero-height: 68svh;
  }
  .hero__media {
    position: absolute;
    inset: 0;
  }
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(20 18 16 / 0.45) 0%, transparent 28%),
      linear-gradient(0deg, rgb(20 18 16 / calc(var(--overlay) + 0.25)) 0%, rgb(20 18 16 / var(--overlay)) 45%, rgb(20 18 16 / calc(var(--overlay) * 0.5)) 100%);
  }
  .hero__media img,
  .hero__video,
  .hero__media .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__image {
    animation: hero-zoom 14s var(--ease-out) both;
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.06);
    }
  }
  .hero__content {
    position: relative;
    display: grid;
    align-content: end;
    gap: var(--space-lg);
    padding-top: calc(var(--header-height) + var(--space-xl));
    padding-bottom: var(--space-lg);
  }
  .hero--center .hero__content {
    align-content: center;
  }
  .hero__copy {
    display: grid;
    gap: var(--space-md);
    max-width: 46rem;
    animation: hero-copy 1.2s var(--ease-out) both 0.15s;
  }
  @keyframes hero-copy {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  .hero--center .hero__copy {
    justify-items: center;
    margin-inline: auto;
    text-align: center;
  }
  .hero__eyebrow {
    color: rgb(247 243 236 / 0.85);
  }
  .hero__heading {
    font-size: var(--heading-xl);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  .hero__heading em {
    color: var(--color-sand);
  }
  .hero__text {
    max-width: 34rem;
    font-size: var(--text-md);
    color: rgb(247 243 236 / 0.85);
  }
  .hero--center .hero__buttons {
    justify-content: center;
  }
  .hero__buttons .button {
    flex: 1 1 14rem;
  }
  .hero__journeys {
    display: grid;
    gap: 1px;
    border-top: 1px solid rgb(247 243 236 / 0.25);
  }
  .hero__journey {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    padding-block: 1rem;
    text-decoration: none;
    border-bottom: 1px solid rgb(247 243 236 / 0.18);
  }
  .hero__journey-index {
    font-family: var(--font-heading--family);
    font-size: var(--text-sm);
    color: var(--color-sand);
  }
  .hero__journey-body {
    display: grid;
    gap: 0.1rem;
  }
  .hero__journey-title {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .hero__journey-text {
    font-size: var(--text-sm);
    color: rgb(247 243 236 / 0.75);
  }
  .hero__journey .icon {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform var(--motion-duration) var(--ease);
  }
  .hero__journey:hover .icon {
    transform: translateX(4px);
  }
  @media (min-width: 750px) {
    .hero__buttons .button {
      flex: 0 0 auto;
    }
    .hero__journeys {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
      gap: var(--space-md);
      border-top: 0;
    }
    .hero__journey {
      border-bottom: 0;
      border-top: 1px solid rgb(247 243 236 / 0.35);
      padding-block: 1.25rem 0.25rem;
    }
  }
  @media (min-width: 990px) {
    .hero__content {
      padding-bottom: var(--space-xl);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.hero_image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:labels.mobile_image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Furniture, considered"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.italic_heading",
      "default": "Rooms that feel <em>made for you</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "Shop ready-stock pieces for your home now, or design a piece around your room, your materials and your measurements."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:labels.primary_button_label",
      "default": "Explore ready stock"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:labels.primary_button_link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:labels.secondary_button_label",
      "default": "Design your furniture"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:labels.secondary_button_link"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:labels.height",
      "options": [
        { "value": "full", "label": "t:options.height.full" },
        { "value": "large", "label": "t:options.height.large" },
        { "value": "medium", "label": "t:options.height.medium" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:labels.content_position",
      "options": [
        { "value": "bottom", "label": "t:options.position.bottom_left" },
        { "value": "center", "label": "t:options.position.center" }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:labels.overlay_opacity",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "journey",
      "name": "t:general.journey",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Ready stock"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Pieces in stock, ready to deliver"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.hero",
      "blocks": [
        { "type": "journey" },
        { "type": "journey", "settings": { "title": "Made to order", "text": "Designed to your room and brief" } }
      ]
    }
  ]
}
{% endschema %}
