<section
  class="hero full-width"
  style="--hero-height: {{ section.settings.height }}svh; --hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }}"
>
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2400 | image_tag:
      widths: '750, 1200, 1600, 2000, 2400',
      sizes: '100vw',
      class: 'hero__image',
      loading: 'eager',
      fetchpriority: 'high',
      alt: section.settings.image.alt
    }}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__image hero__placeholder' }}
  {%- endif -%}

  <div class="hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="heading heading--xl">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    <div class="hero__actions">
      {%- if section.settings.primary_label != blank -%}
        <a class="button" href="{{ section.settings.primary_link | default: routes.collections_url }}">
          {{- section.settings.primary_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a class="button button--secondary hero__secondary" href="{{ section.settings.secondary_link | default: routes.root_url }}">
          {{- section.settings.secondary_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(var(--hero-height), 60rem);
    overflow: hidden;
    color: #fff;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(20 15 12 / var(--hero-overlay));
  }
  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__placeholder {
    background-color: var(--color-surface);
    fill: var(--color-muted);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    max-width: 44rem;
    padding: var(--space-xl) var(--page-margin);
  }
  .hero .eyebrow {
    color: inherit;
  }
  .hero__text {
    max-width: 34rem;
    font-size: var(--text-lg);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }
  .hero .button {
    border-color: #fff;
    background-color: #fff;
    color: var(--color-foreground);
  }
  .hero .button:hover {
    background-color: transparent;
    color: #fff;
  }
  .hero .hero__secondary {
    background-color: transparent;
    color: #fff;
  }
  .hero .hero__secondary:hover {
    background-color: #fff;
    color: var(--color-foreground);
  }
  @media (min-width: 990px) {
    .hero__content {
      padding-inline: max(var(--page-margin), calc((100vw - var(--page-width)) / 2 + var(--page-margin)));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Luxury furniture"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Furniture made to be lived with"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "default": "Ready-to-ship pieces and bespoke commissions, crafted from solid timber and the finest upholstery."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:labels.primary_button_label",
      "default": "Explore ready stock"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:labels.primary_button_link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:labels.secondary_button_label",
      "default": "Design your furniture"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:labels.secondary_button_link"
    },
    {
      "type": "range",
      "id": "height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:labels.height",
      "default": 85
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:labels.overlay_opacity",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
