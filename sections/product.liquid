{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign fields = product.metafields.custom
  assign fulfilment = fields.fulfilment_type.value | default: '' | downcase
  assign is_made_to_order = false
  if fulfilment contains 'order' or product.tags contains 'made-to-order'
    assign is_made_to_order = true
  endif
  assign delivery_text = fields.delivery_estimate.value | default: settings.ready_stock_delivery
  if is_made_to_order
    assign delivery_text = fields.lead_time.value | default: settings.made_to_order_lead_time
  endif
  assign warranty_text = fields.warranty.value | default: settings.warranty_text
  assign low_stock = false
  if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0
    if current_variant.inventory_quantity <= settings.low_stock_threshold
      assign low_stock = true
    endif
  endif
  assign media_count = product.media.size
  assign enquiry_base = section.settings.customise_link | default: settings.enquiry_url
  assign highlights = section.blocks | where: 'type', 'highlight'
  assign collapsibles = section.blocks | where: 'type', 'collapsible'
-%}

<div class="product-page section-spacing--tight" data-product-page data-section-id="{{ section.id }}" data-url="{{ product.url }}">
  <nav class="breadcrumbs product-page__breadcrumbs" aria-label="{{ 'products.breadcrumbs' | t }}">
    <a href="{{ routes.root_url }}">{{ 'products.home' | t }}</a>
    <span aria-hidden="true">/</span>
    {%- if collection != blank -%}
      <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}">{{ 'collections.all_products' | t }}</a>
    {%- endif -%}
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ product.title | escape }}</span>
  </nav>

  <div class="product-page__layout">
    <div class="product-gallery" data-gallery>
      <ul class="product-gallery__track{% if media_count == 1 %} product-gallery__track--single{% endif %}" role="list" data-gallery-track>
        {%- for media in product.media -%}
          <li
            class="product-gallery__item"
            id="media-{{ section.id }}-{{ media.id }}"
            data-media-id="{{ media.id }}"
          >
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <div class="media product-gallery__media" style="aspect-ratio: {{ media.aspect_ratio | default: 0.8 }};">
                  {%- assign media_alt = media.alt | default: product.title | escape -%}
                  {%- if forloop.first -%}
                    {{
                      media
                      | image_url: width: 2000
                      | image_tag:
                        widths: '600, 900, 1200, 1600, 2000',
                        sizes: '(min-width: 990px) 58vw, 100vw',
                        loading: 'eager',
                        fetchpriority: 'high',
                        alt: media_alt
                    }}
                  {%- else -%}
                    {{
                      media
                      | image_url: width: 2000
                      | image_tag:
                        widths: '600, 900, 1200, 1600, 2000',
                        sizes: '(min-width: 990px) 29vw, 100vw',
                        loading: 'lazy',
                        alt: media_alt
                    }}
                  {%- endif -%}
                </div>
              {%- when 'external_video' -%}
                <div class="media product-gallery__media ratio-wide">
                  {{ media | external_video_tag: loading: 'lazy' }}
                </div>
              {%- when 'video' -%}
                <div class="media product-gallery__media" style="aspect-ratio: {{ media.aspect_ratio | default: 1.77 }};">
                  {{ media | video_tag: controls: true, muted: true, playsinline: true, preload: 'metadata' }}
                </div>
              {%- else -%}
                <div class="product-gallery__media product-gallery__model">
                  {{ media | media_tag }}
                </div>
            {%- endcase -%}
          </li>
        {%- else -%}
          <li class="product-gallery__item">
            <div class="media ratio-portrait">
              {% render 'placeholder', type: 'product-2', label: 'Product images, 2000 x 2500' %}
            </div>
          </li>
        {%- endfor -%}
      </ul>
      {%- if media_count > 1 -%}
        <div class="product-gallery__counter" aria-hidden="true">
          <span data-gallery-current>1</span> / {{ media_count }}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      <div class="product-info__sticky">
        <span hidden data-variant-region="featured" data-featured-media="{{ current_variant.featured_media.id }}"></span>
        <div class="product-info__badges" data-variant-region="badges">
          {%- if is_made_to_order -%}
            <span class="badge badge--accent">{{ 'products.badges.made_to_order' | t }}</span>
          {%- else -%}
            <span class="badge badge--dark">{{ 'products.badges.ready_stock' | t }}</span>
          {%- endif -%}
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="badge">{{ 'products.badges.sale' | t }}</span>
          {%- endif -%}
        </div>

        {%- if product.type != blank or product.vendor != blank -%}
          <p class="eyebrow">
            {%- if section.settings.show_vendor and product.vendor != blank -%}
              {{ product.vendor | escape }}
            {%- else -%}
              {{ product.type | escape }}
            {%- endif -%}
          </p>
        {%- endif -%}
        <h1 class="product-info__title heading heading--lg">{{ product.title | escape }}</h1>

        <div class="product-info__price" data-variant-region="price">
          {% render 'price', product: product, variant: current_variant, style: 'large' %}
          <p class="product-info__tax small muted">
            {%- if cart.taxes_included -%}
              {{ 'products.price.taxes_included' | t }}
            {%- else -%}
              {{ 'products.price.taxes_excluded' | t }}
            {%- endif -%}
          </p>
        </div>

        <div class="product-info__availability" data-variant-region="availability" role="status">
          {%- if current_variant.available -%}
            {%- if low_stock -%}
              <span class="stock-dot stock-dot--low"></span>
              {{ 'products.availability.low_stock' | t: count: current_variant.inventory_quantity }}
            {%- elsif is_made_to_order -%}
              <span class="stock-dot"></span>
              {{ 'products.availability.made_to_order' | t }}
            {%- else -%}
              <span class="stock-dot"></span>
              {{ 'products.availability.in_stock' | t }}
            {%- endif -%}
          {%- else -%}
            <span class="stock-dot stock-dot--out"></span>
            {{ 'products.availability.sold_out' | t }}
          {%- endif -%}
        </div>

        {%- if highlights.size > 0 -%}
          <ul class="product-info__highlights" role="list">
            {%- for block in highlights -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}{{ block.settings.text | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- elsif fields.highlights != blank -%}
          <ul class="product-info__highlights" role="list">
            {%- for item in fields.highlights.value -%}
              <li>{% render 'icon', name: 'check' %}{{ item | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- assign form_id = 'product-form-' | append: section.id -%}
        {%- form 'product', product, id: form_id, class: 'product-form', novalidate: 'novalidate', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

          <div data-variant-region="picker">
            {% render 'variant-picker', product: product, section_id: section.id %}
          </div>

          <div class="product-form__buy" data-variant-region="buy">
            {%- assign qty_id = 'quantity-' | append: section.id -%}
            {% render 'quantity-selector', id: qty_id %}
            <button
              type="submit"
              class="button product-form__submit"
              data-add-to-cart
              {% unless current_variant.available %}
                disabled
              {% endunless %}
            >
              {%- if current_variant.available -%}
                {{- 'products.form.add_to_cart' | t -}}
                <span class="product-form__submit-price">· {{ current_variant.price | money }}</span>
              {%- else -%}
                {{- 'products.availability.sold_out' | t -}}
              {%- endif -%}
            </button>
          </div>

          <p class="product-form__status" role="alert" data-form-status hidden></p>

          {%- if section.settings.show_dynamic_checkout -%}
            <div class="product-form__dynamic" data-variant-region="dynamic">
              {%- if current_variant.available -%}
                {{ form | payment_button }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endform -%}

        <div class="product-info__assist">
          {%- if settings.whatsapp_number != blank -%}
            {%- capture wa_message -%}{{ 'whatsapp.product_message' | t: product: product.title, url: canonical_url }}{%- endcapture -%}
            <a
              class="product-info__assist-link"
              href="{% render 'whatsapp-url', message: wa_message %}"
              target="_blank"
              rel="noopener"
              data-track="contact"
              data-track-params='{"method":"whatsapp","location":"product","item_id":{{ product.id | json }}}'
            >
              {% render 'icon', name: 'whatsapp' %}
              <span>{{ 'products.assist.whatsapp' | t }}</span>
            </a>
          {%- endif -%}
          {%- if section.settings.show_customise and enquiry_base != blank -%}
            {%- assign joiner = '?' -%}
            {%- if enquiry_base contains '?' -%}
              {%- assign joiner = '&' -%}
            {%- endif -%}
            <a
              class="product-info__assist-link"
              href="{{ enquiry_base }}{{ joiner }}product={{ product.title | url_encode }}{% if product.type != blank %}&category={{ product.type | url_encode }}{% endif %}"
              data-track="select_journey"
              data-track-params='{"journey":"custom","location":"product","item_id":{{ product.id | json }}}'
            >
              {% render 'icon', name: 'ruler' %}
              <span>{{ 'products.assist.customise' | t }}</span>
            </a>
          {%- endif -%}
        </div>

        {%- if delivery_text != blank or warranty_text != blank -%}
          <ul class="product-info__delivery" role="list">
            {%- if delivery_text != blank -%}
              <li>
                {% render 'icon', name: 'truck' %}
                <div>
                  <p class="product-info__delivery-title">
                    {%- if is_made_to_order -%}
                      {{ 'products.delivery.lead_time' | t }}
                    {%- else -%}
                      {{ 'products.delivery.title' | t }}
                    {%- endif -%}
                  </p>
                  <p class="muted small">{{ delivery_text | escape }}</p>
                </div>
              </li>
            {%- endif -%}
            {%- if warranty_text != blank -%}
              <li>
                {% render 'icon', name: 'shield' %}
                <div>
                  <p class="product-info__delivery-title">{{ 'products.delivery.warranty' | t }}</p>
                  <p class="muted small">{{ warranty_text | escape }}</p>
                </div>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        <div class="product-accordion">
          {%- if product.description != blank -%}
            <details open>
              <summary>{{ 'products.details.description' | t }}{% render 'icon', name: 'plus' %}</summary>
              <div class="product-accordion__content rte">{{ product.description }}</div>
            </details>
          {%- endif -%}

          {%- capture specs -%}{% render 'product-specs', product: product, variant: current_variant %}{%- endcapture -%}
          {%- if specs != blank -%}
            <details>
              <summary>{{ 'products.details.specifications' | t }}{% render 'icon', name: 'plus' %}</summary>
              <div class="product-accordion__content" data-variant-region="specs">{{ specs }}</div>
            </details>
          {%- endif -%}

          {%- if fields.care_instructions != blank -%}
            <details>
              <summary>{{ 'products.details.care' | t }}{% render 'icon', name: 'plus' %}</summary>
              <div class="product-accordion__content rte">{{ fields.care_instructions | metafield_tag }}</div>
            </details>
          {%- endif -%}

          {%- for block in collapsibles -%}
            {%- assign block_content = block.settings.content -%}
            {%- if block.settings.page != blank -%}
              {%- assign block_content = block.settings.page.content -%}
            {%- endif -%}
            {%- if block_content != blank -%}
              <details {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading | escape }}{% render 'icon', name: 'plus' %}</summary>
                <div class="product-accordion__content rte">{{ block_content }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <div class="sticky-buy" data-sticky-buy hidden>
    <div class="sticky-buy__info">
      <p class="sticky-buy__title">{{ product.title | escape }}</p>
      <p class="sticky-buy__price" data-variant-region="sticky-price">{{ current_variant.price | money }}</p>
    </div>
    <button type="submit" form="{{ form_id }}" class="button" data-variant-region="sticky-button" {% unless current_variant.available %}disabled{% endunless %}>
      {%- if current_variant.available -%}
        {{- 'products.form.add_to_cart' | t -}}
      {%- else -%}
        {{- 'products.availability.sold_out' | t -}}
      {%- endif -%}
    </button>
  </div>

  <script type="application/json" data-product-json>
    {
      "id": {{ product.id | json }},
      "title": {{ product.title | json }},
      "type": {{ product.type | json }},
      "vendor": {{ product.vendor | json }},
      "variantId": {{ current_variant.id | json }},
      "variantTitle": {{ current_variant.title | json }},
      "price": {{ current_variant.price | divided_by: 100.0 | json }},
      "fulfilment": {% if is_made_to_order %}"made_to_order"{% else %}"ready_stock"{% endif %}
    }
  </script>
</div>

{% stylesheet %}
  .product-page__breadcrumbs {
    margin-bottom: var(--space-md);
  }
  .product-page__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
  }
  .product-page__layout > * {
    min-width: 0;
  }
  .product-gallery {
    position: relative;
    margin-inline: calc(var(--page-margin) * -1);
  }
  .product-gallery__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .product-gallery__track::-webkit-scrollbar {
    display: none;
  }
  .product-gallery__item {
    scroll-snap-align: start;
  }
  .product-gallery__media {
    width: 100%;
  }
  .product-gallery__media iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .product-gallery__model {
    position: relative;
    aspect-ratio: 1;
  }
  .product-gallery__model model-viewer {
    width: 100%;
    height: 100%;
  }
  .product-gallery__counter {
    position: absolute;
    right: calc(var(--page-margin) + 0.25rem);
    bottom: 1rem;
    padding: 0.3rem 0.7rem;
    background-color: rgb(247 243 236 / 0.9);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
  }
  .product-info__sticky {
    display: grid;
    gap: var(--space-md);
  }
  .product-info__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .product-info__title {
    font-size: clamp(2rem, 1.6rem + 1.6vw, 3rem);
    margin-top: -0.5rem;
  }
  .product-info__tax {
    margin-top: 0.25rem;
  }
  .product-info__availability {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-sm);
  }
  .product-info__highlights {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: var(--space-sm) 0;
    border-block: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
  .product-info__highlights li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .product-info__highlights .icon {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-heading-accent);
  }
  .product-form {
    display: grid;
    gap: var(--space-md);
  }
  .product-form__buy {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
  }
  .product-form__submit {
    min-height: 3.35rem;
  }
  .product-form__submit-price {
    opacity: 0.75;
  }
  .product-form__status {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-error);
    color: var(--color-error);
    font-size: var(--text-sm);
  }
  .product-form__dynamic .shopify-payment-button__button {
    min-height: 3.35rem;
    border-radius: var(--style-border-radius-buttons);
  }
  .product-form__dynamic .shopify-payment-button__button--unbranded {
    background-color: var(--color-accent);
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .product-info__assist {
    display: grid;
    gap: 0.25rem;
  }
  .product-info__assist-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
  }
  .product-info__assist-link:hover {
    text-decoration-color: currentcolor;
  }
  .product-info__assist-link .icon {
    width: 1.2rem;
    height: 1.2rem;
  }
  .product-info__delivery {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: var(--space-md);
    background-color: var(--color-surface);
  }
  .product-info__delivery li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
  }
  .product-info__delivery .icon {
    color: var(--color-heading-accent);
  }
  .product-info__delivery-title {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .product-accordion details {
    border-bottom: 1px solid var(--color-border);
  }
  .product-accordion details:first-child {
    border-top: 1px solid var(--color-border);
  }
  .product-accordion summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.15rem;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }
  .product-accordion summary::-webkit-details-marker {
    display: none;
  }
  .product-accordion summary .icon {
    width: 1rem;
    height: 1rem;
    transition: transform var(--motion-duration) var(--ease);
  }
  .product-accordion details[open] summary .icon {
    transform: rotate(45deg);
  }
  .product-accordion__content {
    padding-bottom: 1.5rem;
    font-size: var(--text-sm);
  }
  .sticky-buy {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 35;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.75rem var(--page-margin);
    background-color: var(--color-ivory);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -12px 30px -20px rgb(0 0 0 / 0.35);
    transform: translateY(110%);
    transition: transform 0.35s var(--ease-out);
  }
  .sticky-buy.is-visible {
    transform: none;
  }
  .sticky-buy[hidden] {
    display: none;
  }
  .sticky-buy__info {
    flex: 1;
    min-width: 0;
  }
  .sticky-buy__title {
    overflow: hidden;
    font-family: var(--font-heading--family);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .sticky-buy__price {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .sticky-buy .button {
    padding-inline: 1.25rem;
  }
  @media (min-width: 750px) {
    .product-gallery {
      margin-inline: 0;
    }
    .product-gallery__track {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-sm);
      overflow: visible;
    }
    .product-gallery__item:first-child,
    .product-gallery__track--single .product-gallery__item {
      grid-column: 1 / -1;
    }
    .product-gallery__counter {
      display: none;
    }
  }
  @media (min-width: 990px) {
    .product-page__layout {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: start;
    }
    .product-info__sticky {
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
    }
    .sticky-buy {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const init = (scope) => {
      const page = scope.querySelector('[data-product-page]');
      if (!page || page.dataset.bound) return;
      page.dataset.bound = 'true';
      const sectionId = page.dataset.sectionId;
      const form = page.querySelector('[data-product-form]');
      const readProduct = () => {
        try {
          return JSON.parse(page.querySelector('[data-product-json]').textContent);
        } catch (error) {
          return {};
        }
      };

      const product = readProduct();
      const itemFor = (data, quantity) => ({
        item_id: String(data.id),
        item_name: data.title,
        item_variant: data.variantTitle,
        item_category: data.type,
        item_brand: data.vendor,
        price: data.price,
        quantity: quantity || 1,
      });
      if (window.AAF) {
        window.AAF.track('view_item', {
          ecommerce: { currency: window.AAFConfig.currency, value: product.price, items: [itemFor(product)] },
          fulfilment: product.fulfilment,
        });
      }

      const track = page.querySelector('[data-gallery-track]');
      const counter = page.querySelector('[data-gallery-current]');
      if (track && counter) {
        track.addEventListener(
          'scroll',
          () => {
            const index = Math.round(track.scrollLeft / track.clientWidth) + 1;
            counter.textContent = index;
          },
          { passive: true }
        );
      }

      const scrollToMedia = (mediaId) => {
        if (!mediaId || !track) return;
        const item = page.querySelector('#media-' + sectionId + '-' + mediaId);
        if (!item) return;
        if (window.matchMedia('(min-width: 750px)').matches) {
          if (item !== track.firstElementChild) track.prepend(item);
        } else {
          track.scrollTo({ left: item.offsetLeft, behavior: 'smooth' });
        }
      };

      const updateVariant = async (changed) => {
        const ids = Array.from(page.querySelectorAll('[data-option-value-id]:checked')).map((input) => input.dataset.optionValueId);
        const url = page.dataset.url + '?option_values=' + ids.join(',') + '&section_id=' + sectionId;
        const qtyInput = form.querySelector('input[name="quantity"]');
        const quantity = qtyInput ? qtyInput.value : 1;
        page.classList.add('is-updating');
        try {
          const response = await fetch(url);
          const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
          doc.querySelectorAll('[data-variant-region]').forEach((next) => {
            const current = page.querySelector('[data-variant-region="' + next.dataset.variantRegion + '"]');
            if (current) current.replaceWith(next);
          });
          const nextJson = doc.querySelector('[data-product-json]');
          if (nextJson) page.querySelector('[data-product-json]').textContent = nextJson.textContent;
          const data = readProduct();
          form.querySelector('[data-variant-input]').value = data.variantId;
          const newQty = form.querySelector('input[name="quantity"]');
          if (newQty) newQty.value = quantity;
          window.history.replaceState({}, '', page.dataset.url + '?variant=' + data.variantId);
          const focusTarget = document.getElementById(changed.id);
          if (focusTarget) focusTarget.focus();
          const nextMedia = doc.querySelector('[data-featured-media]');
          scrollToMedia(nextMedia ? nextMedia.dataset.featuredMedia : null);
        } catch (error) {
          window.location.href = page.dataset.url;
        } finally {
          page.classList.remove('is-updating');
        }
      };

      page.addEventListener('change', (event) => {
        if (event.target.matches('[data-option-value-id]')) updateVariant(event.target);
      });

      form.addEventListener('submit', async (event) => {
        if (!window.AAF || !window.AAF.cart) return;
        event.preventDefault();
        const status = page.querySelector('[data-form-status]');
        const buttons = document.querySelectorAll('[data-add-to-cart], [data-variant-region="sticky-button"]');
        buttons.forEach((b) => b.classList.add('is-loading'));
        status.hidden = true;
        try {
          const formData = new FormData(form);
          await window.AAF.cart.add(formData);
          const data = readProduct();
          const quantity = Number(formData.get('quantity') || 1);
          window.AAF.track('add_to_cart', {
            ecommerce: { currency: window.AAFConfig.currency, value: data.price * quantity, items: [itemFor(data, quantity)] },
            fulfilment: data.fulfilment,
          });
          if (window.AAF.cart.hasDrawer()) window.AAF.cart.open(event.submitter);
          else window.location.href = window.AAFConfig.routes.cart;
        } catch (error) {
          status.textContent = error.message;
          status.hidden = false;
        } finally {
          buttons.forEach((b) => b.classList.remove('is-loading'));
        }
      });

      const sticky = page.querySelector('[data-sticky-buy]');
      const buy = page.querySelector('.product-form__buy');
      if (sticky && buy && 'IntersectionObserver' in window) {
        sticky.hidden = false;
        new IntersectionObserver(([entry]) => {
          sticky.classList.toggle('is-visible', !entry.isIntersecting && entry.boundingClientRect.top < 0);
        }).observe(buy);
      }
    };
    init(document);
    document.addEventListener('shopify:section:load', (event) => init(event.target));
  })();
{% endjavascript %}

