{% doc %}
  Renders a product card: primary and hover image, journey badge (ready stock
  or made to order), sale / sold-out / low-stock badges, product type,
  title, price, material line and an optional quick add for single-variant
  products. Uses the custom.fulfilment_type and custom.material metafields
  when present.

  @param {product} product - The product to display
  @param {string} [sizes] - Responsive sizes attribute for the image
  @param {boolean} [show_quick_add] - Show the quick add control (default true)
  @param {boolean} [eager] - Load the image eagerly (first row above the fold)
  @param {string} [list_name] - Analytics list name for select_item events

  @example
  {% render 'product-card', product: product %}
  {% render 'product-card', product: product, sizes: '(min-width: 990px) 33vw, 50vw', list_name: 'Featured' %}
{% enddoc %}

{%- liquid
  assign image_sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign variant = product.selected_or_first_available_variant
  assign fulfilment = product.metafields.custom.fulfilment_type.value | default: '' | downcase
  assign is_made_to_order = false
  if fulfilment contains 'order' or product.tags contains 'made-to-order'
    assign is_made_to_order = true
  endif
  assign secondary = product.media[1]
  assign quick_add = true
  if show_quick_add == false
    assign quick_add = false
  endif
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
  assign low_stock = false
  if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0
    if variant.inventory_quantity <= settings.low_stock_threshold
      assign low_stock = true
    endif
  endif
  assign material_field = product.metafields.custom.material
  assign card_alt = product.featured_media.alt | default: product.title | escape
-%}

<article class="product-card">
  <a
    class="product-card__link"
    href="{{ product.url }}"
    data-track="select_item"
    data-track-params='{"item_list_name":{{ list_name | default: 'Product grid' | strip_html | json | escape }},"ecommerce":{"items":[{"item_id":{{ product.id | json }},"item_name":{{ product.title | json | escape }},"price":{{ product.price | divided_by: 100.0 | json }}}]}}'
  >
    <div class="product-card__media media {{ settings.card_image_ratio }}{% if secondary and settings.card_show_secondary_image %} product-card__media--hover{% endif %}">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 1100
          | image_tag:
            widths: '360, 540, 720, 900, 1100',
            sizes: image_sizes,
            loading: loading,
            alt: card_alt,
            class: 'product-card__image'
        }}
        {%- if secondary and settings.card_show_secondary_image and secondary.media_type == 'image' -%}
          {{
            secondary
            | image_url: width: 1100
            | image_tag:
              widths: '360, 540, 720, 900, 1100',
              sizes: image_sizes,
              loading: 'lazy',
              alt: '',
              class: 'product-card__image product-card__image--secondary'
          }}
        {%- endif -%}
      {%- else -%}
        {% render 'placeholder', type: 'product-1', label: 'Product image, 1200 x 1500' %}
      {%- endif -%}

      <div class="product-card__badges">
        {%- unless product.available -%}
          <span class="badge badge--dark">{{ 'products.badges.sold_out' | t }}</span>
        {%- else -%}
          {%- if product.compare_at_price > product.price -%}
            <span class="badge badge--accent">{{ 'products.badges.sale' | t }}</span>
          {%- endif -%}
          {%- if is_made_to_order -%}
            <span class="badge">{{ 'products.badges.made_to_order' | t }}</span>
          {%- else -%}
            <span class="badge">{{ 'products.badges.ready_stock' | t }}</span>
          {%- endif -%}
        {%- endunless -%}
      </div>
    </div>
  </a>

  <div class="product-card__info">
    {%- if product.type != blank -%}
      <p class="product-card__type eyebrow">{{ product.type | escape }}</p>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>
    {%- if material_field != blank -%}
      <p class="product-card__material">
        {%- if material_field.type contains 'metaobject' -%}
          {%- for material in material_field.value -%}
            {{ material.title.value | default: material.name.value | escape }}{% unless forloop.last %} · {% endunless %}
          {%- endfor -%}
        {%- else -%}
          {{ material_field.value | escape }}
        {%- endif -%}
      </p>
    {%- endif -%}
    <div class="product-card__bottom">
      {% render 'price', product: product %}
      {%- if low_stock -%}
        <span class="product-card__stock"><span class="stock-dot stock-dot--low"></span>{{ 'products.availability.low_stock_short' | t: count: variant.inventory_quantity }}</span>
      {%- endif -%}
    </div>

    {%- if quick_add and product.available -%}
      {%- if product.has_only_default_variant -%}
        {%- form 'product', product, class: 'product-card__quick', data-quick-add: '' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <button
            type="submit"
            class="product-card__quick-button"
            data-item='{"item_id":{{ product.id | json }},"item_variant":{{ variant.id | json }},"item_name":{{ product.title | json | escape }},"item_category":{{ product.type | json | escape }},"price":{{ variant.price | divided_by: 100.0 | json }}}'
          >
            {% render 'icon', name: 'plus' %}
            <span>{{ 'products.form.quick_add' | t }}</span>
          </button>
        {%- endform -%}
      {%- else -%}
        <a class="product-card__quick-button" href="{{ product.url }}">
          {% render 'icon', name: 'arrow' %}
          <span>{{ 'products.form.choose_options' | t }}</span>
        </a>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .product-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .product-card__link {
    display: block;
    text-decoration: none;
  }
  .product-card__image {
    transition:
      opacity 0.6s var(--ease),
      transform 1.2s var(--ease-out);
  }
  .product-card__image--secondary {
    opacity: 0;
  }
  @media (hover: hover) {
    .product-card__link:hover .product-card__media--hover .product-card__image--secondary {
      opacity: 1;
    }
    .product-card__link:hover .product-card__image {
      transform: scale(1.03);
    }
  }
  .product-card__badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .product-card__info {
    display: grid;
    gap: 0.3rem;
  }
  .product-card__type {
    font-size: 0.65rem;
  }
  .product-card__title {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.3;
  }
  .product-card__title a {
    text-decoration: none;
  }
  .product-card__title a:hover {
    color: var(--color-accent);
  }
  .product-card__material {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .product-card__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.2rem;
  }
  .product-card__stock {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .product-card__quick {
    margin: 0;
    justify-self: start;
  }
  .product-card__quick-button {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    padding: 0.35rem 0;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    background: none;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color var(--motion-duration) var(--ease),
      color var(--motion-duration) var(--ease);
  }
  .product-card__quick-button:hover {
    border-color: currentcolor;
    color: var(--color-accent);
  }
  .product-card__quick-button .icon {
    width: 0.9rem;
    height: 0.9rem;
  }
  .product-card__quick-button.is-loading {
    opacity: 0.5;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('submit', async (event) => {
    const form = event.target.closest('[data-quick-add]');
    if (!form || !window.AAF || !window.AAF.cart) return;
    event.preventDefault();
    const button = form.querySelector('button');
    button.classList.add('is-loading');
    try {
      await window.AAF.cart.add(new FormData(form));
      let item = {};
      try {
        item = JSON.parse(button.dataset.item || '{}');
      } catch (error) {}
      window.AAF.track('add_to_cart', {
        ecommerce: { currency: window.AAFConfig.currency, value: item.price, items: [Object.assign({ quantity: 1 }, item)] },
      });
      if (window.AAF.cart.hasDrawer()) window.AAF.cart.open(button);
      else window.location.href = window.AAFConfig.routes.cart;
    } catch (error) {
      form.submit();
    } finally {
      button.classList.remove('is-loading');
    }
  });
{% endjavascript %}
