{% doc %}
  Renders a product card with image, title, price and availability badge.

  @param {product} product - The product to display
  @param {string} [sizes] - The responsive sizes attribute for the image

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

<article class="product-card">
  <a class="product-card__link" href="{{ product.url }}">
    <div class="product-card__media image-frame">
      {%- if product.featured_image -%}
        {%- assign image_sizes = sizes | default: '(min-width: 990px) 25vw, 50vw' -%}
        {%- assign image_alt = product.featured_image.alt | default: product.title -%}
        {{ product.featured_image | image_url: width: 900 | image_tag:
          widths: '300, 450, 600, 900',
          sizes: image_sizes,
          loading: 'lazy',
          alt: image_alt
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
      {%- endif -%}
      {%- unless product.available -%}
        <span class="product-card__badge">{{ 'products.badges.sold_out' | t }}</span>
      {%- endunless -%}
    </div>
    <h3 class="product-card__title heading heading--sm">{{ product.title | escape }}</h3>
  </a>
  {% render 'price', product: product %}
</article>

{% stylesheet %}
  .product-card__link {
    display: block;
    text-decoration: none;
  }
  .product-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
  }
  .product-card__media img,
  .product-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.75rem;
    background-color: var(--color-background);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .product-card__title {
    margin-block: 0.9rem 0.25rem;
    font-size: var(--text-lg);
  }
{% endstylesheet %}
