{% doc %}
  Outputs JSON-LD structured data: Organization and WebSite on every page,
  Product on product pages (via Shopify's structured_data filter, which
  includes offers, availability and variants), Article on articles, and
  BreadcrumbList on product and collection pages.

  @example
  {% render 'structured-data' %}
{% enddoc %}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: routes.root_url | json }}
    {%- if settings.logo != blank -%}
      ,"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
    {%- endif -%}
    {%- if settings.contact_phone != blank -%}
      ,"telephone": {{ settings.contact_phone | json }}
    {%- endif -%}
    {%- if settings.contact_email != blank -%}
      ,"email": {{ settings.contact_email | json }}
    {%- endif -%}
    ,"sameAs": [
      {%- assign social_links = settings.social_instagram | append: '|' | append: settings.social_pinterest | append: '|' | append: settings.social_facebook | append: '|' | append: settings.social_youtube | append: '|' | append: settings.social_linkedin | split: '|' | compact -%}
      {%- assign first_written = false -%}
      {%- for link in social_links -%}
        {%- if link != blank -%}
          {%- if first_written -%},{%- endif -%}
          {{ link | json }}
          {%- assign first_written = true -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  }
</script>

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <script type="application/ld+json">
    {{ article | structured_data }}
  </script>
{%- endif -%}

{%- if request.page_type == 'product' or request.page_type == 'collection' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'products.home' | t | json }},
          "item": {{ request.origin | append: routes.root_url | json }}
        }
        {%- if collection -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ request.origin | append: collection.url | json }}
          }
        {%- endif -%}
        {%- if request.page_type == 'product' -%}
          ,{
            "@type": "ListItem",
            "position": {% if collection %}3{% else %}2{% endif %},
            "name": {{ product.title | json }},
            "item": {{ request.origin | append: product.url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
