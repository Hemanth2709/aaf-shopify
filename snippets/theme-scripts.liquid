{% doc %}
  Global behaviour shared by every page: scroll reveal, the cart API used by
  product forms and the cart drawer, and delegated [data-track] click
  tracking. window.AAF.track and window.AAFConfig are defined earlier by
  snippets/analytics-init.liquid.

  @example
  {% render 'theme-scripts' %}
{% enddoc %}

{% javascript %}
  (() => {
    const config = window.AAFConfig || { routes: {} };
    const AAF = (window.AAF = window.AAF || {});

    document.addEventListener('click', (event) => {
      const el = event.target.closest('[data-track]');
      if (!el) return;
      let params = {};
      try {
        params = JSON.parse(el.dataset.trackParams || '{}');
      } catch (error) {}
      AAF.track(el.dataset.track, params);
    });

    const reveal = () => {
      const root = document.documentElement;
      if (!root.classList.contains('js-motion')) return;
      if (!('IntersectionObserver' in window)) {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-revealed'));
        return;
      }
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -6% 0px' }
      );
      const observe = (scope) => scope.querySelectorAll('[data-reveal]:not(.is-revealed)').forEach((el) => observer.observe(el));
      observe(document);
      document.addEventListener('shopify:section:load', (event) => observe(event.target));
    };
    reveal();

    const safeStore = {
      get(key, fallback) {
        try {
          const raw = window.localStorage.getItem(key);
          return raw ? JSON.parse(raw) : fallback;
        } catch (error) {
          return fallback;
        }
      },
      set(key, value) {
        try {
          window.localStorage.setItem(key, JSON.stringify(value));
        } catch (error) {}
      },
    };
    AAF.store = safeStore;

    const rootUrl = (config.routes.root || '/').replace(/\/$/, '');
    AAF.renderCards = async (handles, container, emptyEl) => {
      if (!container) return 0;
      const html = await Promise.all(
        handles.map((handle) =>
          fetch(rootUrl + '/products/' + encodeURIComponent(handle) + '?section_id=product-card-render')
            .then((r) => (r.ok ? r.text() : ''))
            .catch(() => '')
        )
      );
      container.innerHTML = '';
      let count = 0;
      html.forEach((chunk) => {
        const card = new DOMParser().parseFromString(chunk, 'text/html').querySelector('[data-card-render]');
        if (!card) return;
        const li = document.createElement('li');
        li.innerHTML = card.innerHTML;
        container.appendChild(li);
        count++;
      });
      if (emptyEl) emptyEl.hidden = count > 0;
      AAF.wishlist.sync();
      return count;
    };

    AAF.wishlist = {
      key: 'aaf-wishlist',
      get() {
        return safeStore.get(this.key, []);
      },
      has(handle) {
        return this.get().includes(handle);
      },
      toggle(handle, title) {
        let list = this.get();
        const adding = !list.includes(handle);
        list = adding ? [handle].concat(list).slice(0, 48) : list.filter((h) => h !== handle);
        safeStore.set(this.key, list);
        this.sync();
        AAF.track(adding ? 'add_to_wishlist' : 'remove_from_wishlist', { item_id: handle, item_name: title });
        document.dispatchEvent(new CustomEvent('aaf:wishlist', { detail: { list } }));
        return adding;
      },
      sync() {
        const list = this.get();
        document.querySelectorAll('[data-wishlist-toggle]').forEach((button) => {
          const active = list.includes(button.dataset.handle);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
          button.classList.toggle('is-active', active);
        });
        document.querySelectorAll('[data-wishlist-count]').forEach((el) => {
          el.textContent = list.length;
          el.hidden = list.length === 0;
        });
      },
    };

    AAF.recent = {
      key: 'aaf-recently-viewed',
      add(handle) {
        const list = safeStore.get(this.key, []).filter((h) => h !== handle);
        list.unshift(handle);
        safeStore.set(this.key, list.slice(0, 12));
      },
      get(exclude) {
        return safeStore.get(this.key, []).filter((h) => h !== exclude);
      },
    };

    document.addEventListener('click', (event) => {
      const button = event.target.closest('[data-wishlist-toggle]');
      if (!button) return;
      event.preventDefault();
      AAF.wishlist.toggle(button.dataset.handle, button.dataset.title);
    });
    AAF.wishlist.sync();
    document.addEventListener('shopify:section:load', () => AAF.wishlist.sync());

    const drawerSectionId = 'cart-drawer';

    AAF.cart = {
      hasDrawer() {
        return config.cartType === 'drawer' && !!document.getElementById('cart-drawer');
      },
      async request(url, body, isJson) {
        const response = await fetch(url, {
          method: 'POST',
          headers: Object.assign(
            { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            isJson ? { 'Content-Type': 'application/json' } : {}
          ),
          body,
        });
        const data = await response.json();
        if (!response.ok || data.status) {
          const error = new Error(data.description || data.message || 'Cart error');
          error.data = data;
          throw error;
        }
        return data;
      },
      async add(formData) {
        if (this.hasDrawer()) {
          formData.append('sections', drawerSectionId);
          formData.append('sections_url', window.location.pathname);
        }
        const data = await this.request(config.routes.cartAdd + '.js', formData, false);
        if (data.sections) this.render(data.sections);
        return data;
      },
      async change(line, quantity) {
        const body = { line, quantity };
        if (this.hasDrawer()) {
          body.sections = [drawerSectionId];
          body.sections_url = window.location.pathname;
        }
        const data = await this.request(config.routes.cartChange + '.js', JSON.stringify(body), true);
        if (data.sections) this.render(data.sections);
        return data;
      },
      render(sections) {
        const html = sections && sections[drawerSectionId];
        if (!html) return;
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const next = doc.querySelector('[data-cart-drawer-content]');
        const current = document.querySelector('[data-cart-drawer-content]');
        if (next && current) current.replaceWith(next);
        const count = next ? next.dataset.cartCount : null;
        if (count !== null && count !== undefined) this.updateCount(Number(count));
      },
      updateCount(count) {
        document.querySelectorAll('[data-cart-count]').forEach((el) => {
          el.textContent = count;
          el.hidden = count === 0;
        });
        document.querySelectorAll('[data-cart-count-label]').forEach((el) => {
          el.textContent = (el.dataset.template || '').replace('[count]', count);
        });
      },
      open(trigger) {
        const drawer = document.getElementById('cart-drawer');
        if (!drawer) {
          window.location.href = config.routes.cart;
          return;
        }
        if (!drawer.open) drawer.showModal();
        AAF.cart.lastTrigger = trigger || document.activeElement;
        const totalEl = drawer.querySelector('[data-cart-drawer-content]');
        AAF.track('view_cart', {
          ecommerce: {
            currency: config.currency,
            value: totalEl ? Number(totalEl.dataset.cartTotal || 0) / 100 : 0,
          },
        });
      },
    };

    document.addEventListener('click', (event) => {
      const opener = event.target.closest('[data-cart-open]');
      if (opener && AAF.cart.hasDrawer()) {
        event.preventDefault();
        AAF.cart.open(opener);
      }
    });
  })();
{% endjavascript %}
