{% doc %}
  Renders a clearly labelled temporary image placeholder in the brand palette.
  Used wherever a merchant image has not been uploaded yet. Fills its
  positioned parent (for example a .media wrapper with an aspect ratio).

  @param {string} [type] - Shopify placeholder illustration: image, lifestyle-1, lifestyle-2, product-1 to product-6, collection-1 to collection-6
  @param {string} [label] - Short description of the image that should replace it
  @param {string} [tone] - Visual tone: light (default) or dark

  @example
  {% render 'placeholder', type: 'lifestyle-1', label: 'Hero, 2400 x 1350' %}
{% enddoc %}

<div class="placeholder placeholder--{{ tone | default: 'light' }}" role="img" aria-label="{{ 'general.placeholder.aria' | t }}">
  {{ type | default: 'image' | placeholder_svg_tag: 'placeholder__svg' }}
  {%- if label != blank -%}
    <span class="placeholder__label">{{ 'general.placeholder.label' | t: label: label }}</span>
  {%- endif -%}
</div>

{% stylesheet %}
  .placeholder {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 20% 10%, rgb(255 255 255 / 0.55), transparent 60%),
      linear-gradient(160deg, var(--color-surface), var(--color-sand));
    color: rgb(90 62 43 / 0.28);
  }
  .placeholder--dark {
    background:
      radial-gradient(120% 90% at 80% 0%, rgb(255 255 255 / 0.08), transparent 60%),
      linear-gradient(160deg, #3a332d, #1f1c1a);
    color: rgb(247 243 236 / 0.12);
  }
  .placeholder__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: currentcolor;
  }
  .placeholder__label {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.55rem;
    background-color: rgb(34 32 30 / 0.72);
    color: #f7f3ec;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }
{% endstylesheet %}
