{% doc %}
  Renders an inline line icon that inherits the current text colour.

  @param {string} name - Icon name: heart, eye, search, account, cart, menu, close, arrow, arrow-left, plus, minus, chevron, check, whatsapp, phone, mail, truck, shield, ruler, leaf, tool, sofa, calendar, star, pin, clock, returns, award, chat, upload, home, instagram, pinterest, facebook, youtube, linkedin
  @param {string} [class] - Optional class added to the svg element

  @example
  {% render 'icon', name: 'search' %}
{% enddoc %}

{%- liquid
  assign filled = false
  case name
    when 'whatsapp', 'instagram', 'pinterest', 'facebook', 'youtube', 'linkedin', 'star'
      assign filled = true
  endcase
-%}

<svg
  class="icon icon--{{ name }} {{ class }}"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  {% if filled %}
    fill="currentColor"
  {% else %}
    fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"
  {% endif %}
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-3.5 3.7-5.5 7-5.5s6.2 2 7 5.5"/>
    {%- when 'cart' -%}
      <path d="M4.5 8.5h15l-1.2 11a1.5 1.5 0 0 1-1.5 1.3H7.2a1.5 1.5 0 0 1-1.5-1.3z"/><path d="M8.5 8.5V7a3.5 3.5 0 0 1 7 0v1.5"/>
    {%- when 'menu' -%}
      <path d="M3.5 7h17M3.5 12h17M3.5 17h11"/>
    {%- when 'close' -%}
      <path d="m5.5 5.5 13 13m0-13-13 13"/>
    {%- when 'arrow' -%}
      <path d="M3.5 12h17m-6-6 6 6-6 6"/>
    {%- when 'arrow-left' -%}
      <path d="M20.5 12h-17m6-6-6 6 6 6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'chevron' -%}
      <path d="m6 9.5 6 6 6-6"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'phone' -%}
      <path d="M5 4h3.5l1.5 4.2-2.2 1.4a11 11 0 0 0 6.6 6.6l1.4-2.2L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4"/>
    {%- when 'mail' -%}
      <rect x="3.5" y="5.5" width="17" height="13" rx="1"/><path d="m4 6.5 8 6.5 8-6.5"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v10h-11zM13.5 10h4l3 3.2v3.3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'shield' -%}
      <path d="M12 3.5 19 6v5.5c0 4.4-3 7.8-7 9-4-1.2-7-4.6-7-9V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>
    {%- when 'ruler' -%}
      <path d="m3.5 16.5 13-13 4 4-13 13z"/><path d="m7 13 1.8 1.8M10 10l1.8 1.8M13 7l1.8 1.8"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-13.5 15-14.5-.5 10-6 15-14 15"/><path d="M5 19c3-4 6-6.5 9.5-8.5"/>
    {%- when 'tool' -%}
      <path d="M14.5 5.5a4 4 0 0 0 4.9 4.9l-9.2 9.2a2 2 0 1 1-2.8-2.8z"/><path d="m14.5 5.5 2-2 4 4-2 2"/>
    {%- when 'sofa' -%}
      <path d="M5 11V8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v3"/><path d="M3 12.5a1.5 1.5 0 0 1 3 0V15h12v-2.5a1.5 1.5 0 0 1 3 0V18H3z"/><path d="M5 18v1.5M19 18v1.5"/>
    {%- when 'calendar' -%}
      <rect x="3.5" y="5" width="17" height="15" rx="1"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
    {%- when 'star' -%}
      <path d="m12 3.5 2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/>
    {%- when 'pin' -%}
      <path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11"/><circle cx="12" cy="10" r="2.3"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'returns' -%}
      <path d="M4.5 9.5h11a4.5 4.5 0 0 1 0 9h-4"/><path d="m8 6-3.5 3.5L8 13"/>
    {%- when 'award' -%}
      <circle cx="12" cy="9" r="5.5"/><path d="m8.5 13.5-1.5 7 5-2.5 5 2.5-1.5-7"/>
    {%- when 'chat' -%}
      <path d="M4 5.5h16v10H9.5L5 19.5v-4H4z"/>
    {%- when 'upload' -%}
      <path d="M12 15.5V4m-4.5 4.5L12 4l4.5 4.5"/><path d="M4.5 15v4.5h15V15"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20"/>
    {%- when 'eye' -%}
      <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12"/><circle cx="12" cy="12" r="3"/>
    {%- when 'home' -%}
      <path d="m3.5 11 8.5-7 8.5 7"/><path d="M5.5 9.5v10h13v-10"/><path d="M10 19.5v-5h4v5"/>
    {%- when 'whatsapp' -%}
      <path d="M12 2.2a9.8 9.8 0 0 0-8.4 14.8L2.3 21.8l4.9-1.3A9.8 9.8 0 1 0 12 2.2m0 17.9a8.1 8.1 0 0 1-4.2-1.2l-.3-.2-2.9.8.8-2.8-.2-.3A8.1 8.1 0 1 1 12 20.1m4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3a.4.4 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.1-.3-.2-.5-.3"/>
    {%- when 'instagram' -%}
      <path d="M12 7.2a4.8 4.8 0 1 0 0 9.6 4.8 4.8 0 0 0 0-9.6m0 7.9a3.1 3.1 0 1 1 0-6.2 3.1 3.1 0 0 1 0 6.2m6.1-8.1a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0M21.5 8a5.5 5.5 0 0 0-1.5-3.9A5.5 5.5 0 0 0 16 2.6C14.5 2.5 9.5 2.5 8 2.6a5.5 5.5 0 0 0-3.9 1.5A5.5 5.5 0 0 0 2.6 8c-.1 1.5-.1 6.5 0 8a5.5 5.5 0 0 0 1.5 3.9A5.5 5.5 0 0 0 8 21.4c1.5.1 6.5.1 8 0a5.5 5.5 0 0 0 3.9-1.5 5.5 5.5 0 0 0 1.5-3.9c.2-1.5.2-6.5.1-8m-2 9.7a3.2 3.2 0 0 1-1.8 1.8c-1.3.5-4.3.4-5.7.4s-4.4.1-5.7-.4a3.2 3.2 0 0 1-1.8-1.8c-.5-1.3-.4-4.3-.4-5.7s-.1-4.4.4-5.7a3.2 3.2 0 0 1 1.8-1.8c1.3-.5 4.3-.4 5.7-.4s4.4-.1 5.7.4a3.2 3.2 0 0 1 1.8 1.8c.5 1.3.4 4.3.4 5.7s.1 4.4-.4 5.7"/>
    {%- when 'pinterest' -%}
      <path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.5 2.1-.8 3.3-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.5 2.2-4.5 4.4 0 .9.3 1.8.8 2.3a.3.3 0 0 1 0 .3l-.3 1.2c0 .2-.2.2-.4.1-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2.1-1.3 2.8A10 10 0 1 0 12 2"/>
    {%- when 'facebook' -%}
      <path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12"/>
    {%- when 'youtube' -%}
      <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8M10 15V9l5.2 3z"/>
    {%- when 'linkedin' -%}
      <path d="M20.4 2H3.6A1.6 1.6 0 0 0 2 3.6v16.8A1.6 1.6 0 0 0 3.6 22h16.8a1.6 1.6 0 0 0 1.6-1.6V3.6A1.6 1.6 0 0 0 20.4 2M8 19H5V9.5h3zM6.5 8.2a1.7 1.7 0 1 1 0-3.5 1.7 1.7 0 0 1 0 3.5M19 19h-3v-4.6c0-1.1 0-2.5-1.5-2.5s-1.8 1.2-1.8 2.4V19h-3V9.5h2.8v1.3a3.1 3.1 0 0 1 2.8-1.5c3 0 3.6 2 3.6 4.6z"/>
  {%- endcase -%}
</svg>

{% stylesheet %}
  .icon {
    width: 1.375rem;
    height: 1.375rem;
    flex-shrink: 0;
  }
{% endstylesheet %}
